@model WebApplication1.Models.ViewModels.BarbershopDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

<div class="container my-5">
    <!-- Back Button -->
    <div class="row mb-3">
        <div class="col-12">
            <a asp-action="Index" class="btn btn-outline-primary">
                <i class="fas fa-arrow-left"></i> Voltar à Lista
            </a>
        </div>
    </div>

    <div class="row">
        <!-- Barbershop Image -->
        <div class="col-lg-5 mb-4">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="img-fluid rounded shadow-lg-custom" alt="@Model.Name">
            }
            else
            {
                <div class="bg-light rounded shadow-lg-custom d-flex align-items-center justify-content-center" style="height: 400px;">
                    <i class="fas fa-store fa-8x text-muted"></i>
                </div>
            }
        </div>

        <!-- Barbershop Details -->
        <div class="col-lg-7">
            <div class="card shadow-custom">
                <div class="card-body">
                    <h1 class="card-title mb-3">@Model.Name</h1>
                    
                    <div class="rating mb-3">
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= Math.Round(Model.AverageRating))
                            {
                                <i class="fas fa-star fa-lg"></i>
                            }
                            else
                            {
                                <i class="far fa-star fa-lg"></i>
                            }
                        }
                        <span class="ms-2">
                            <strong>@Model.AverageRating.ToString("0.0")</strong> 
                            (@Model.LocalReviews.Count @(Model.LocalReviews.Count == 1 ? "avaliação" : "avaliações"))
                        </span>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <p class="lead">@Model.Description</p>
                    }

                    <hr />

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <h6><i class="fas fa-map-marker-alt text-accent"></i> Localização:</h6>
                            <p>@Model.Address</p>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.PhoneNumber))
                        {
                            <div class="col-md-6">
                                <h6><i class="fas fa-phone text-accent"></i> Telefone:</h6>
                                <p><a href="tel:@Model.PhoneNumber">@Model.PhoneNumber</a></p>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(Model.Email))
                        {
                            <div class="col-md-6">
                                <h6><i class="fas fa-envelope text-accent"></i> Email:</h6>
                                <p><a href="mailto:@Model.Email">@Model.Email</a></p>
                            </div>
                        }

                        <div class="col-md-12 mt-3">
                            <h6><i class="fas fa-map-marked-alt text-accent"></i> Mapa:</h6>
                            <div id="map" style="height: 300px; width: 100%; border-radius: 8px; z-index: 1;"></div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.OpeningHours))
                        {
                            <div class="col-md-6 mt-3">
                                <h6><i class="fas fa-clock text-accent"></i> Horário:</h6>
                                <p>@Model.OpeningHours</p>
                            </div>
                        }
                    </div>

                    <div class="d-grid gap-2 d-md-flex">
                        <a asp-controller="Bookings" asp-action="Create" asp-route-barbershopId="@Model.Id" 
                           class="btn btn-primary btn-lg flex-fill">
                            <i class="fas fa-calendar-plus"></i> Fazer Reserva
                        </a>
                        <a asp-controller="Reviews" asp-action="Create" asp-route-barbershopId="@Model.Id" 
                           class="btn btn-outline-primary btn-lg flex-fill">
                            <i class="fas fa-star"></i> Avaliar
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Services Section -->
    @if (Model.Services != null && Model.Services.Any())
    {
        <div class="row mt-5">
            <div class="col-12">
                <h3 class="mb-4"><i class="fas fa-scissors text-accent"></i> Serviços Disponíveis</h3>
            </div>
        </div>
        <div class="row g-3">
            @foreach (var service in Model.Services.Where(s => s.IsAvailable))
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100">
                        <div class="card-body">
                            <h5 class="card-title">
                                @service.Name
                                @if (service.IsHomeService)
                                {
                                    <span class="badge bg-info text-dark ms-2" title="Serviço ao Domicílio">
                                        <i class="fas fa-home"></i> Domicílio
                                    </span>
                                }
                            </h5>
                            @if (!string.IsNullOrEmpty(service.Description))
                            {
                                <p class="card-text text-muted">@service.Description</p>
                            }
                            <p class="mb-1">
                                <strong class="text-accent">€@service.Price.ToString("0.00")</strong>
                            </p>
                            <p class="text-muted small">
                                <i class="fas fa-clock"></i> @service.DurationMinutes min
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Reviews Section -->
    <div class="row mt-5">
        <div class="col-12">
            <h3 class="mb-4"><i class="fas fa-comments text-accent"></i> Comentários e Avaliações</h3>
            
            <ul class="nav nav-tabs mb-4" id="reviewTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="local-reviews-tab" data-bs-toggle="tab" data-bs-target="#local-reviews" type="button" role="tab" aria-controls="local-reviews" aria-selected="true">
                        <i class="fas fa-home me-2"></i>Avaliações BarberLoc (@(Model.LocalReviews?.Count ?? 0))
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="google-reviews-tab" data-bs-toggle="tab" data-bs-target="#google-reviews" type="button" role="tab" aria-controls="google-reviews" aria-selected="false">
                        <i class="fab fa-google text-danger me-2"></i>Comentários Google Maps
                    </button>
                </li>
            </ul>

            <div class="tab-content" id="reviewTabsContent">
                <!-- Local Reviews Tab -->
                <div class="tab-pane fade show active" id="local-reviews" role="tabpanel" aria-labelledby="local-reviews-tab">
                    @if (Model.LocalReviews != null && Model.LocalReviews.Any())
                    {
                        <div class="row g-3">
                            @foreach (var review in Model.LocalReviews.OrderByDescending(r => r.CreatedAt))
                            {
                                <div class="col-12">
                                    <div class="card shadow-sm border-0">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div>
                                                    <h6 class="mb-1 fw-bold">
                                                        <i class="fas fa-user-circle text-accent"></i> 
                                                        @(review.User?.FullName ?? review.User?.UserName ?? "Anónimo")
                                                    </h6>
                                                    <div class="rating mb-2">
                                                        @for (int i = 1; i <= 5; i++)
                                                        {
                                                            if (i <= review.Rating)
                                                            {
                                                                <i class="fas fa-star"></i>
                                                            }
                                                            else
                                                            {
                                                                <i class="far fa-star"></i>
                                                            }
                                                        }
                                                    </div>
                                                </div>
                                                <small class="text-muted">@review.CreatedAt.ToString("dd/MM/yyyy")</small>
                                            </div>
                                            @if (!string.IsNullOrEmpty(review.Comment))
                                            {
                                                <p class="mb-0 mt-2">@review.Comment</p>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> Ainda não há avaliações locais para esta barbearia. Seja o primeiro a avaliar!
                        </div>
                    }
                </div>

                <!-- Google Reviews Tab -->
                <div class="tab-pane fade" id="google-reviews" role="tabpanel" aria-labelledby="google-reviews-tab">
                    @if (Model.Reviews != null && Model.Reviews.Any())
                    {
                        <div class="row g-3">
                            @foreach (var review in Model.Reviews)
                            {
                                <div class="col-12">
                                    <div class="card shadow-sm border-0 bg-light-custom" style="background-color: #f8f9fa;">
                                        <div class="card-body p-3">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div>
                                                    <h6 class="mb-1 fw-bold">
                                                        <i class="fab fa-google text-danger me-2"></i>@review.AuthorName
                                                    </h6>
                                                    <div class="rating mb-2">
                                                        @for (int i = 1; i <= 5; i++)
                                                        {
                                                            if (i <= review.Rating)
                                                            {
                                                                <i class="fas fa-star text-warning"></i>
                                                            }
                                                            else
                                                            {
                                                                <i class="far fa-star text-warning"></i>
                                                            }
                                                        }
                                                    </div>
                                                </div>
                                                <small class="text-muted">@review.RelativeTimeDescription</small>
                                            </div>
                                            <p class="mb-0 mt-2 text-dark" style="line-height:1.5; font-size:0.9rem;">@review.Text</p>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> Não foram encontrados comentários do Google Maps para esta localização.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function initMap() {
            var lat = @Model.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture);
            var lng = @Model.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture);
            var location = { lat: lat, lng: lng };
            
            if (lat !== 0 && lng !== 0) {
                var map = new google.maps.Map(document.getElementById('map'), {
                    zoom: 15,
                    center: location
                });
                var marker = new google.maps.Marker({
                    position: location,
                    map: map,
                    title: '@Html.Raw(Model.Name.Replace("'", "\\'"))'
                });
            } else {
                document.getElementById('map').innerHTML = '<div class="d-flex justify-content-center align-items-center h-100 bg-light text-muted">Localização indisponível</div>';
            }
        }
    </script>
    <script async defer src="https://maps.googleapis.com/maps/api/js?key=@Model.GoogleApiKey&callback=initMap"></script>
}
