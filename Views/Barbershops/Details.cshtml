@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@model WebApplication1.Models.ViewModels.BarbershopDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

@* Hidden field: API key for the embedded Directions iframe *@
<input type="hidden" id="google-maps-api-key" value="@Configuration["GoogleMaps:ApiKey"]" />

<div class="container my-5">


    <div class="row">
        <!-- Barbershop Photos Carousel -->
        <div class="col-lg-5 mb-4">
            @if (Model.Photos != null && Model.Photos.Any())
            {
                <div id="barbershopCarousel" class="carousel slide rounded shadow-lg-custom overflow-hidden" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        @foreach (var photo in Model.Photos)
                        {
                            <div class="carousel-item @(photo.Index == 0 ? "active" : "")">
                                <img src="@photo.ProxyUrl" class="d-block w-100" style="object-fit: cover; height: 400px;" alt="Photo of @Model.Name">
                            </div>
                        }
                    </div>
                    @if (Model.Photos.Count > 1)
                    {
                        <button class="carousel-control-prev" type="button" data-bs-target="#barbershopCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Anterior</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#barbershopCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Próximo</span>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="bg-light rounded shadow-lg-custom d-flex align-items-center justify-content-center" style="height: 400px;">
                    <i class="fas fa-store fa-8x text-muted"></i>
                </div>
            }
        </div>

        <!-- Barbershop Details -->
        <div class="col-lg-7">
            <div class="card shadow-custom border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div class="d-flex align-items-center">
                            <h1 class="card-title fw-bold mb-0 me-3">@Model.Name</h1>
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <form id="form-favorite-toggle" method="post" action="@(Model.IsFavourited ? "/Favorites/Remove" : "/Favorites/Add")" class="d-inline m-0 p-0">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="barbershopId" value="@Model.Id" />
                                    <button type="button" id="btn-favorite-toggle" class="btn btn-link p-0 m-0 border-0 text-decoration-none" style="font-size: 1.8rem; color: @(Model.IsFavourited ? "#dc3545" : "#6c757d");" title="@(Model.IsFavourited ? "Remover dos Favoritos" : "Adicionar aos Favoritos")">
                                        <i class="@(Model.IsFavourited ? "fas fa-heart" : "far fa-heart")"></i>
                                    </button>
                                </form>
                            }
                        </div>
                        @if (Model.IsOpenNow.HasValue)
                        {
                            if (Model.IsOpenNow.Value)
                            {
                                <span class="badge bg-success rounded-pill px-3 py-2 fs-6"><i class="fas fa-door-open me-1"></i> Aberto Agora</span>
                            }
                            else
                            {
                                <span class="badge bg-danger rounded-pill px-3 py-2 fs-6"><i class="fas fa-door-closed me-1"></i> Fechado</span>
                            }
                        }
                    </div>
                    
                    <div class="rating mb-4 d-flex align-items-center">
                        @if (Model.GoogleRating.HasValue)
                        {
                            <div class="text-warning me-2 fs-5">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= Math.Round(Model.GoogleRating.Value))
                                    {
                                        <i class="fas fa-star"></i>
                                    }
                                    else
                                    {
                                        <i class="far fa-star"></i>
                                    }
                                }
                            </div>
                            <span class="fs-5 fw-bold me-1">@Model.GoogleRating.Value.ToString("0.0")</span>
                            <span class="text-muted">(<i class="fab fa-google text-danger mx-1"></i> @Model.UserRatingsTotal avaliações)</span>
                        }
                        else
                        {
                            <span class="text-muted"><i class="fas fa-info-circle"></i> Avaliação indisponível</span>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <p class="lead text-secondary">@Model.Description</p>
                    }

                    <hr class="text-muted" />

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <h6 class="text-uppercase text-muted fw-bold mb-2"><i class="fas fa-map-marker-alt text-accent"></i> Localização</h6>
                            <p class="mb-0 fs-6">@Model.Address</p>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.FormattedPhoneNumber))
                        {
                            <div class="col-md-6">
                                <h6 class="text-uppercase text-muted fw-bold mb-2"><i class="fas fa-phone text-accent"></i> Contacto</h6>
                                <p class="mb-0 fs-6">
                                    <a href="tel:@(Model.InternationalPhoneNumber ?? Model.FormattedPhoneNumber)" class="text-decoration-none">
                                        @Model.FormattedPhoneNumber
                                    </a>
                                </p>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(Model.Website))
                        {
                            <div class="col-md-6">
                                <h6 class="text-uppercase text-muted fw-bold mb-2"><i class="fas fa-globe text-accent"></i> Website</h6>
                                <p class="mb-0 fs-6">
                                    <a href="@Model.Website" target="_blank" rel="noopener noreferrer" class="text-decoration-none">
                                        Visitar Website <i class="fas fa-external-link-alt ms-1 small"></i>
                                    </a>
                                </p>
                            </div>
                        }

                        @if (Model.WeekdayText != null && Model.WeekdayText.Any())
                        {
                            <div class="col-md-6">
                                <h6 class="text-uppercase text-muted fw-bold mb-2"><i class="fas fa-clock text-accent"></i> Horário</h6>
                                <ul class="list-unstyled mb-0 fs-6">
                                    @foreach (var day in Model.WeekdayText)
                                    {
                                        <li class="mb-1">@day</li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>



                    <div class="d-flex flex-wrap gap-2 mt-auto">
                        <a id="btn-fazer-reserva" asp-controller="Bookings" asp-action="Create" asp-route-barbershopId="@Model.Id" 
                           class="btn btn-primary btn-lg flex-fill rounded-pill shadow-sm">
                            <i class="fas fa-calendar-plus me-2"></i> Fazer Reserva
                        </a>
                        <a href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(Model.Name ?? Model.Address ?? "")" 
                           target="_blank" rel="noopener noreferrer"
                           class="btn btn-outline-secondary btn-lg flex-fill rounded-pill shadow-sm">
                            <i class="fab fa-google me-2"></i> Ver no Google Maps
                        </a>
                        <button id="btn-favoritos" class="btn btn-outline-dark btn-lg flex-fill rounded-pill shadow-sm" type="button" onclick="toggleFavoritosHeader(this)">
                            <i id="heart-icon" class="far fa-heart me-2"></i><span id="favoritos-text">Favoritos</span>
                        </button>
                    </div>
                    <div class="d-flex flex-wrap gap-2 mt-2">
                        <button type="button" id="btn-details-directions"
                                class="btn btn-outline-secondary btn-lg flex-fill rounded-pill shadow-sm"
                                onclick="toggleDetailsDirections()">
                            <i class="fas fa-route me-2"></i> Como Chegar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- UBER EATS STYLE SIMULATION STANDALONE -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow-sm border-0 my-4" style="border-left: 5px solid #28a745 !important; background: linear-gradient(135deg, #ffffff, #f8f9fa);">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-2"><i class="fas fa-motorcycle text-success me-2"></i> Pedir Barbeiro ao Domicílio (Estilo Uber)</h5>
                    <p class="text-secondary small mb-3">Ative o interruptor abaixo para que o profissional se desloque à sua morada com uma taxa estimada em tempo real.</p>
                    
                    <!-- Toggle Switch -->
                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="domicilio-toggle-switch" style="cursor: pointer; width: 45px; height: 22px;">
                        <label class="form-check-label fw-bold ms-2" for="domicilio-toggle-switch" style="cursor: pointer;">Solicitar atendimento em minha Casa</label>
                    </div>

                    <!-- Dynamic Inputs & Actions (Hidden until toggled) -->
                    <div id="domicilio-interactive-panel" style="display: none; border-top: 1px dashed #dee2e6; padding-top: 15px;">
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted">Introduza a sua morada de entrega:</label>
                            <div class="input-group">
                                <input type="text" id="domicilio-user-address" class="form-control" placeholder="Ex: Rua da Glória, Lisboa...">
                                <button class="btn btn-dark fw-bold" type="button" id="domicilio-calc-btn">Calcular Deslocação</button>
                            </div>
                        </div>

                        <!-- Dynamic Fee Results Display Box -->
                        <div id="domicilio-results-box" class="alert alert-success d-none py-2 px-3 my-2">
                            <div class="d-flex justify-content-between align-items-center small fw-bold">
                                <span id="domicilio-distance-text" class="text-secondary"></span>
                                <span id="domicilio-fee-text" class="text-success" style="font-size: 1.1rem;"></span>
                            </div>
                        </div>

                        <!-- Final Action Submission Button -->
                        <div id="domicilio-submit-block" class="d-none mt-3">
                            <a id="domicilio-final-link" href="/Bookings/Create?barbershopId=@Model.Id&shopName=@Uri.EscapeDataString(Model.Name ?? "")" class="btn btn-success btn-lg w-100 fw-bold rounded-pill shadow-sm">
                                <i class="fas fa-check-circle me-2"></i> Confirmar e Chamar Barbeiro
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Map Section -->
    <div class="row mt-5">
        <div class="col-12">
            <h3 class="mb-4 fw-bold"><i class="fas fa-map-marked-alt text-accent me-2"></i> Localização no Mapa</h3>
            <div id="map" class="shadow-sm border" style="height: 400px; width: 100%; border-radius: 12px; z-index: 1;"></div>
        </div>
    </div>

    <!-- Embedded Directions Section -->
    <div id="details-directions-section" class="row mt-4" style="display:none !important;">
        <div class="col-12">
            <div class="card border-0 shadow-sm" style="border-radius:1rem; overflow:hidden;">
                <div class="card-header d-flex align-items-center justify-content-between py-3 px-4"
                     style="background:linear-gradient(135deg,#0d1b3e,#1a2a5c); border-bottom:1px solid rgba(255,255,255,0.08);">
                    <span class="fw-semibold" style="color:#e2e8f0;">
                        <i class="fas fa-route me-2" style="color:#4f7cf0;"></i>Rota até @Model.Name
                    </span>
                    <button type="button" class="btn btn-sm" style="color:#94a3b8;"
                            onclick="toggleDetailsDirections()">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div id="details-directions-loading" class="text-center py-4" style="display:none;">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 text-muted small">A calcular rota...</p>
                </div>
                <div id="details-geo-error" class="d-none px-4 pt-3">
                    <div class="alert alert-warning py-2 small">
                        <i class="fas fa-exclamation-triangle me-1"></i>
                        Localização não disponível. A mostrar destino no mapa.
                    </div>
                </div>
                <iframe id="details-directions-iframe"
                        src=""
                        width="100%"
                        height="420"
                        style="border:0; display:none;"
                        allowfullscreen
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        aria-label="Mapa de rota até @Model.Name"></iframe>
            </div>
        </div>
    </div>

    <!-- Services Section -->
    @if (Model.Services != null && Model.Services.Any())
    {
        <div class="row mt-5">
            <div class="col-12">
                <h3 class="mb-4 fw-bold"><i class="fas fa-scissors text-accent me-2"></i> Serviços Disponíveis</h3>
            </div>
        </div>
        <div class="row g-4">
            @foreach (var service in Model.Services.Where(s => s.IsAvailable))
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm service-card transition-hover">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h5 class="card-title fw-bold mb-0 text-dark">
                                    @service.Name
                                </h5>
                                <span class="badge bg-primary text-white rounded-pill px-3 py-2 fs-6 service-price-badge">
                                    €@service.Price.ToString("0.00")
                                </span>
                            </div>
                            
                            @if (service.IsHomeService)
                            {
                                <div class="mb-3">
                                    <span class="badge bg-info bg-opacity-10 text-info border border-info rounded-pill">
                                        <i class="fas fa-home me-1"></i> Domicílio
                                    </span>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(service.Description))
                            {
                                <p class="card-text text-secondary mb-4">@service.Description</p>
                            }
                            
                            <div class="mt-auto d-flex align-items-center text-muted">
                                <i class="far fa-clock me-2"></i> 
                                <span class="fw-medium">@service.DurationMinutes minutos</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Reviews Section -->
    <div class="row mt-5 mb-5">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="fw-bold mb-0"><i class="fas fa-comments text-accent me-2"></i> Comentários</h3>
            </div>

            @if (Model.Reviews != null && Model.Reviews.Any())
            {
                <div class="row g-4">
                    @foreach (var review in Model.Reviews)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 shadow-sm border-0 bg-white">
                                <div class="card-body p-4">
                                    <div class="d-flex align-items-center mb-3">
                                        @if (!string.IsNullOrEmpty(review.ProfilePhotoUrl))
                                        {
                                            <img src="@review.ProfilePhotoUrl" alt="@review.AuthorName" class="rounded-circle me-3" style="width: 48px; height: 48px; object-fit: cover;">
                                        }
                                        else
                                        {
                                            <div class="bg-secondary rounded-circle d-flex align-items-center justify-content-center me-3 text-white fw-bold" style="width: 48px; height: 48px;">
                                                @(review.AuthorName.Length > 0 ? review.AuthorName.Substring(0,1).ToUpper() : "?")
                                            </div>
                                        }
                                        <div>
                                            <h6 class="mb-0 fw-bold">@review.AuthorName</h6>
                                            <small class="text-muted">@review.RelativeTimeDescription</small>
                                        </div>
                                    </div>
                                    
                                    <div class="rating mb-3 text-warning">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= review.Rating)
                                            {
                                                <i class="fas fa-star"></i>
                                            }
                                            else
                                            {
                                                <i class="far fa-star"></i>
                                            }
                                        }
                                    </div>
                                    
                                    <p class="card-text text-secondary" style="font-size: 0.95rem; line-height: 1.6;">
                                        @review.Text
                                    </p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="card shadow-sm border-0 bg-light">
                    <div class="card-body p-5 text-center">
                        <div class="text-muted mb-3">
                            <i class="fas fa-comment-slash fa-3x"></i>
                        </div>
                        <h5 class="fw-bold">Ainda sem avaliações disponíveis</h5>
                        <p class="text-secondary mb-0">Nenhuma avaliação foi encontrada para esta localização.</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ── Details page map (Google Maps JS) ──────────────────────────────
        function initMap() {
            var lat = @Model.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture);
            var lng = @Model.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture);
            var location = { lat: lat, lng: lng };
            
            if (lat !== 0 && lng !== 0) {
                var map = new google.maps.Map(document.getElementById('map'), {
                    zoom: 15,
                    center: location
                });
                var marker = new google.maps.Marker({
                    position: location,
                    map: map,
                    title: '@Html.Raw(Model.Name.Replace("'", "\\'"))'
                });
            } else {
                document.getElementById('map').innerHTML = '<div class="d-flex justify-content-center align-items-center h-100 bg-light text-muted">Localização indisponível</div>';
            }
        }

        // ── Embedded in-page Directions ────────────────────────────────────
        // Builds a Google Maps Embed Directions iframe — user stays on BarberLoc.
        var _detailsDirectionsOpen = false;
        var _detailsDestination    = '@Html.Raw(Model.Address?.Replace("'", "\\'") ?? Model.Name.Replace("'", "\\'"))';
        var _detailsApiKey         = document.getElementById('google-maps-api-key')?.value || '';

        function toggleDetailsDirections() {
            var section  = document.getElementById('details-directions-section');
            var iframe   = document.getElementById('details-directions-iframe');
            var loading  = document.getElementById('details-directions-loading');
            var geoErr   = document.getElementById('details-geo-error');
            var btn      = document.getElementById('btn-details-directions');

            _detailsDirectionsOpen = !_detailsDirectionsOpen;

            if (!_detailsDirectionsOpen) {
                section.style.display = 'none';
                iframe.style.display  = 'none';
                iframe.src = '';
                return;
            }

            // Show the section
            section.style.removeProperty('display');
            if (loading) loading.style.display = 'block';
            if (geoErr)  geoErr.classList.add('d-none');
            iframe.style.display = 'none';

            function buildEmbedUrl(originParam) {
                var base = 'https://www.google.com/maps/embed/v1/';
                var url = '';
                if (originParam) {
                    url = base + 'directions?destination=' + encodeURIComponent(_detailsDestination) + '&mode=walking&origin=' + encodeURIComponent(originParam);
                } else {
                    url = base + 'place?q=' + encodeURIComponent(_detailsDestination);
                }
                if (_detailsApiKey) url += '&key=' + encodeURIComponent(_detailsApiKey);
                return url;
            }

            function showIframe(src) {
                iframe.src = src;
                iframe.style.display = 'block';
                if (loading) loading.style.display = 'none';
            }

            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    function(pos) {
                        var origin = pos.coords.latitude + ',' + pos.coords.longitude;
                        showIframe(buildEmbedUrl(origin));
                    },
                    function() {
                        if (geoErr) geoErr.classList.remove('d-none');
                        showIframe(buildEmbedUrl(null));
                    },
                    { timeout: 6000, maximumAge: 60000 }
                );
            } else {
                if (geoErr) geoErr.classList.remove('d-none');
                showIframe(buildEmbedUrl(null));
            }
        }

        // ── Uber Style Domicílio Simulation ──
        document.addEventListener('DOMContentLoaded', function() {
            const toggle = document.getElementById('domicilio-toggle-switch');
            const panel = document.getElementById('domicilio-interactive-panel');
            const calcBtn = document.getElementById('domicilio-calc-btn');
            const addressInput = document.getElementById('domicilio-user-address');
            const resultsBox = document.getElementById('domicilio-results-box');
            const distanceText = document.getElementById('domicilio-distance-text');
            const feeText = document.getElementById('domicilio-fee-text');
            const submitBlock = document.getElementById('domicilio-submit-block');
            const finalLink = document.getElementById('domicilio-final-link');
            const mainReservaBtn = document.getElementById('btn-fazer-reserva');
            
            // Capture shopId and shopName for safe routing
            const shopId = '@Model.Id';
            const shopName = '@Html.Raw(Model.Name?.Replace("'", "\\'") ?? "")';
            
            let currentNotes = "";

            if(toggle) {
                toggle.addEventListener('change', function() {
                    if(this.checked) {
                        panel.style.display = 'block';
                    } else {
                        panel.style.display = 'none';
                        resultsBox.classList.add('d-none');
                        submitBlock.classList.add('d-none');
                        currentNotes = "";
                        updateLinks();
                    }
                });
            }

            if(calcBtn) {
                calcBtn.addEventListener('click', function() {
                    const addr = addressInput.value.trim();
                    if(!addr) {
                        alert("Por favor, introduza uma morada válida.");
                        return;
                    }
                    
                    calcBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> A calcular...';
                    calcBtn.disabled = true;
                    
                    setTimeout(() => {
                        const distance = (Math.random() * 6 + 2).toFixed(1); // 2km to 8km
                        const fee = (distance * 0.50).toFixed(2);
                        
                        distanceText.innerHTML = `<i class="fas fa-car me-1"></i> Distância: ${distance} km`;
                        feeText.innerHTML = `+€${fee}`;
                        
                        resultsBox.classList.remove('d-none');
                        
                        currentNotes = `[Serviço ao Domicílio (Uber-Style)] Morada: ${addr} | Distância: ${distance}km | Taxa Adicional: €${fee}`;
                        updateLinks();
                        
                        calcBtn.innerHTML = 'Calcular Deslocação';
                        calcBtn.disabled = false;
                        
                        submitBlock.classList.remove('d-none');
                    }, 800);
                });
            }

            function updateLinks() {
                // Always include both barbershopId AND shopName so the
                // Bookings controller can resolve the shop regardless of
                // whether the ID is a real DB row or a Google Places proxy.
                const baseHref = `/Bookings/Create?barbershopId=${encodeURIComponent(shopId)}&shopName=${encodeURIComponent(shopName)}`;

                // Update the Uber-style confirm button
                if (finalLink) {
                    finalLink.href = currentNotes
                        ? `${baseHref}&Notes=${encodeURIComponent(currentNotes)}`
                        : baseHref;
                }

                // Only patch the main "Fazer Reserva" button when there ARE
                // home-service notes — otherwise leave the tag-helper URL intact.
                if (mainReservaBtn && currentNotes) {
                    mainReservaBtn.href = `${baseHref}&Notes=${encodeURIComponent(currentNotes)}`;
                } else if (mainReservaBtn && !currentNotes) {
                    // Reset to the original server-rendered href (no stale notes)
                    mainReservaBtn.href = `/Bookings/Create?barbershopId=${encodeURIComponent(shopId)}&shopName=${encodeURIComponent(shopName)}`;
                }
            }
        });

        // ── Favorites AJAX Toggle ──
        const favBtn = document.getElementById('btn-favorite-toggle');
        if(favBtn) {
            favBtn.addEventListener('click', function(e) {
                e.preventDefault();
                const form = document.getElementById('form-favorite-toggle');
                const url = form.getAttribute('action');
                const formData = new FormData(form);

                fetch(url, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(response => response.json())
                .then(data => {
                    if(data.success) {
                        const icon = favBtn.querySelector('i');
                        if(data.isFavorited) {
                            icon.classList.remove('far');
                            icon.classList.add('fas');
                            favBtn.style.color = '#dc3545';
                            form.setAttribute('action', '/Favorites/Remove');
                            favBtn.setAttribute('title', 'Remover dos Favoritos');
                        } else {
                            icon.classList.remove('fas');
                            icon.classList.add('far');
                            favBtn.style.color = '#6c757d';
                            form.setAttribute('action', '/Favorites/Add');
                            favBtn.setAttribute('title', 'Adicionar aos Favoritos');
                        }
                    }
                })
                .catch(err => console.error("Error toggling favorite", err));
            });
        }

        // ── Favoritos Header Button (PAP Demo) ──
        var _favHeaderActive = @(Model.IsFavourited ? "true" : "false");

        // Toast helper
        function showFavToast(msg, color) {
            var existing = document.getElementById('fav-toast-banner');
            if (existing) existing.remove();

            var toast = document.createElement('div');
            toast.id = 'fav-toast-banner';
            toast.style.cssText = [
                'position:fixed', 'bottom:28px', 'left:50%', 'transform:translateX(-50%) translateY(60px)',
                'background:' + color, 'color:#fff', 'padding:14px 28px', 'border-radius:50px',
                'font-size:1rem', 'font-weight:600', 'z-index:9999',
                'box-shadow:0 8px 30px rgba(0,0,0,0.25)',
                'display:flex', 'align-items:center', 'gap:10px',
                'transition:transform 0.35s cubic-bezier(.34,1.56,.64,1), opacity 0.35s ease',
                'opacity:0', 'pointer-events:none'
            ].join(';');
            toast.innerHTML = msg;
            document.body.appendChild(toast);

            requestAnimationFrame(function() {
                requestAnimationFrame(function() {
                    toast.style.transform = 'translateX(-50%) translateY(0)';
                    toast.style.opacity = '1';
                });
            });

            setTimeout(function() {
                toast.style.transform = 'translateX(-50%) translateY(60px)';
                toast.style.opacity = '0';
                setTimeout(function() { toast.remove(); }, 400);
            }, 2800);
        }

        function toggleFavoritosHeader(btn) {
            var icon = document.getElementById('fav-header-icon') || document.getElementById('heart-icon');
            var smallHeart = document.getElementById('btn-favorite-toggle');
            var form = document.getElementById('form-favorite-toggle');

            // Enforce login to save favorites
            if (!form) {
                window.location.href = '/Identity/Account/Login?ReturnUrl=' + encodeURIComponent(window.location.pathname + window.location.search);
                return;
            }

            if (!_favHeaderActive) {
                // Animate: outline -> filled red
                icon.classList.remove('far');
                icon.classList.add('fas');
                icon.style.color = '#dc3545';
                btn.classList.remove('btn-outline-dark');
                btn.classList.add('btn-danger');
                btn.innerHTML = '<i class="fas fa-heart me-2" id="fav-header-icon" style="color:#fff;"></i> Nos Favoritos';
                _favHeaderActive = true;

                // Sync the small heart icon too
                if (smallHeart) {
                    var si = smallHeart.querySelector('i');
                    if (si) { si.classList.remove('far'); si.classList.add('fas'); }
                    smallHeart.style.color = '#dc3545';
                    if (form) form.setAttribute('action', '/Favorites/Remove');
                }

                showFavToast('<i class="fas fa-heart" style="color:#ff6b8a;"></i>&nbsp; Adicionado aos Favoritos!', 'linear-gradient(135deg,#1a1a2e,#16213e)');

                // Fire the actual AJAX toggle if the small heart form exists
                if (form) {
                    var fd = new FormData(form);
                    fetch('/Favorites/Add', { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                        .catch(function() {});
                }
            } else {
                // Animate back: filled -> outline
                btn.classList.remove('btn-danger');
                btn.classList.add('btn-outline-dark');
                btn.innerHTML = '<i class="far fa-heart me-2" id="fav-header-icon"></i> Favoritos';
                _favHeaderActive = false;

                // Sync the small heart icon
                if (smallHeart) {
                    var si2 = smallHeart.querySelector('i');
                    if (si2) { si2.classList.remove('fas'); si2.classList.add('far'); }
                    smallHeart.style.color = '#6c757d';
                    if (form) form.setAttribute('action', '/Favorites/Add');
                }

                showFavToast('<i class="fas fa-heart-broken"></i>&nbsp; Removido dos Favoritos.', '#6c757d');

                if (form) {
                    var fd2 = new FormData(form);
                    fetch('/Favorites/Remove', { method: 'POST', body: fd2, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                        .catch(function() {});
                }
            }
        }

        // Sync btn-favoritos state on page load if already favourited
        document.addEventListener('DOMContentLoaded', function() {
            var favBtn = document.getElementById('btn-favoritos');
            var favIcon = document.getElementById('heart-icon');
            var favText = document.getElementById('favoritos-text');
            if (_favHeaderActive && favBtn && favIcon && favText) {
                favIcon.className = 'fas fa-heart text-danger me-2';
                favBtn.className = 'btn btn-danger btn-lg flex-fill rounded-pill shadow-sm';
                favText.innerText = 'Nos Favoritos';
            }
        });
    </script>
    <script async defer src="https://maps.googleapis.com/maps/api/js?key=@Configuration["GoogleMaps:ApiKey"]&callback=initMap"></script>
}

