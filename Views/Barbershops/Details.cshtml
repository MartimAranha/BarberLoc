@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@model WebApplication1.Models.ViewModels.BarbershopDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

@* Hidden field: API key for the embedded Directions iframe *@
<input type="hidden" id="google-maps-api-key" value="@Configuration["GoogleMaps:ApiKey"]" />

<div class="container my-5">
    <!-- Back Button -->
    <div class="row mb-3">
        <div class="col-12">
            <a asp-action="Index" class="btn btn-outline-primary">
                <i class="fas fa-arrow-left"></i> Voltar à Lista
            </a>
        </div>
    </div>

    <div class="row">
        <!-- Barbershop Photos Carousel -->
        <div class="col-lg-5 mb-4">
            @if (Model.Photos != null && Model.Photos.Any())
            {
                <div id="barbershopCarousel" class="carousel slide rounded shadow-lg-custom overflow-hidden" data-bs-ride="carousel">
                    <div class="carousel-inner">
                        @foreach (var photo in Model.Photos)
                        {
                            <div class="carousel-item @(photo.Index == 0 ? "active" : "")">
                                <img src="@photo.ProxyUrl" class="d-block w-100" style="object-fit: cover; height: 400px;" alt="Photo of @Model.Name">
                            </div>
                        }
                    </div>
                    @if (Model.Photos.Count > 1)
                    {
                        <button class="carousel-control-prev" type="button" data-bs-target="#barbershopCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Anterior</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#barbershopCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Próximo</span>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="bg-light rounded shadow-lg-custom d-flex align-items-center justify-content-center" style="height: 400px;">
                    <i class="fas fa-store fa-8x text-muted"></i>
                </div>
            }
        </div>

        <!-- Barbershop Details -->
        <div class="col-lg-7">
            <div class="card shadow-custom border-0 h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h1 class="card-title fw-bold mb-0">@Model.Name</h1>
                        @if (Model.IsOpenNow.HasValue)
                        {
                            if (Model.IsOpenNow.Value)
                            {
                                <span class="badge bg-success rounded-pill px-3 py-2 fs-6"><i class="fas fa-door-open me-1"></i> Aberto Agora</span>
                            }
                            else
                            {
                                <span class="badge bg-danger rounded-pill px-3 py-2 fs-6"><i class="fas fa-door-closed me-1"></i> Fechado</span>
                            }
                        }
                    </div>
                    
                    <div class="rating mb-4 d-flex align-items-center">
                        @if (Model.GoogleRating.HasValue)
                        {
                            <div class="text-warning me-2 fs-5">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= Math.Round(Model.GoogleRating.Value))
                                    {
                                        <i class="fas fa-star"></i>
                                    }
                                    else
                                    {
                                        <i class="far fa-star"></i>
                                    }
                                }
                            </div>
                            <span class="fs-5 fw-bold me-1">@Model.GoogleRating.Value.ToString("0.0")</span>
                            <span class="text-muted">(<i class="fab fa-google text-danger mx-1"></i> @Model.UserRatingsTotal avaliações)</span>
                        }
                        else
                        {
                            <span class="text-muted"><i class="fas fa-info-circle"></i> Avaliação indisponível</span>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <p class="lead text-secondary">@Model.Description</p>
                    }

                    <hr class="text-muted" />

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <h6 class="text-uppercase text-muted fw-bold mb-2"><i class="fas fa-map-marker-alt text-accent"></i> Localização</h6>
                            <p class="mb-0 fs-6">@Model.Address</p>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.FormattedPhoneNumber))
                        {
                            <div class="col-md-6">
                                <h6 class="text-uppercase text-muted fw-bold mb-2"><i class="fas fa-phone text-accent"></i> Contacto</h6>
                                <p class="mb-0 fs-6">
                                    <a href="tel:@(Model.InternationalPhoneNumber ?? Model.FormattedPhoneNumber)" class="text-decoration-none">
                                        @Model.FormattedPhoneNumber
                                    </a>
                                </p>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(Model.Website))
                        {
                            <div class="col-md-6">
                                <h6 class="text-uppercase text-muted fw-bold mb-2"><i class="fas fa-globe text-accent"></i> Website</h6>
                                <p class="mb-0 fs-6">
                                    <a href="@Model.Website" target="_blank" rel="noopener noreferrer" class="text-decoration-none">
                                        Visitar Website <i class="fas fa-external-link-alt ms-1 small"></i>
                                    </a>
                                </p>
                            </div>
                        }

                        @if (Model.WeekdayText != null && Model.WeekdayText.Any())
                        {
                            <div class="col-md-6">
                                <h6 class="text-uppercase text-muted fw-bold mb-2"><i class="fas fa-clock text-accent"></i> Horário</h6>
                                <ul class="list-unstyled mb-0 fs-6">
                                    @foreach (var day in Model.WeekdayText)
                                    {
                                        <li class="mb-1">@day</li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>

                    <div class="d-grid gap-2 d-md-flex mt-auto">
                        <a asp-controller="Bookings" asp-action="Create" asp-route-barbershopId="@Model.Id" 
                           class="btn btn-primary btn-lg flex-fill rounded-pill shadow-sm">
                            <i class="fas fa-calendar-plus me-2"></i> Fazer Reserva
                        </a>
                        <button type="button" id="btn-details-directions"
                                class="btn btn-outline-secondary btn-lg flex-fill rounded-pill shadow-sm"
                                onclick="toggleDetailsDirections()">
                            <i class="fas fa-route me-2"></i> Como Chegar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Map Section -->
    <div class="row mt-5">
        <div class="col-12">
            <h3 class="mb-4 fw-bold"><i class="fas fa-map-marked-alt text-accent me-2"></i> Localização no Mapa</h3>
            <div id="map" class="shadow-sm border" style="height: 400px; width: 100%; border-radius: 12px; z-index: 1;"></div>
        </div>
    </div>

    <!-- Embedded Directions Section -->
    <div id="details-directions-section" class="row mt-4" style="display:none !important;">
        <div class="col-12">
            <div class="card border-0 shadow-sm" style="border-radius:1rem; overflow:hidden;">
                <div class="card-header d-flex align-items-center justify-content-between py-3 px-4"
                     style="background:linear-gradient(135deg,#0d1b3e,#1a2a5c); border-bottom:1px solid rgba(255,255,255,0.08);">
                    <span class="fw-semibold" style="color:#e2e8f0;">
                        <i class="fas fa-route me-2" style="color:#4f7cf0;"></i>Rota até @Model.Name
                    </span>
                    <button type="button" class="btn btn-sm" style="color:#94a3b8;"
                            onclick="toggleDetailsDirections()">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <div id="details-directions-loading" class="text-center py-4" style="display:none;">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 text-muted small">A calcular rota...</p>
                </div>
                <div id="details-geo-error" class="d-none px-4 pt-3">
                    <div class="alert alert-warning py-2 small">
                        <i class="fas fa-exclamation-triangle me-1"></i>
                        Localização não disponível. A mostrar destino no mapa.
                    </div>
                </div>
                <iframe id="details-directions-iframe"
                        src=""
                        width="100%"
                        height="420"
                        style="border:0; display:none;"
                        allowfullscreen
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        aria-label="Mapa de rota até @Model.Name"></iframe>
            </div>
        </div>
    </div>

    <!-- Services Section -->
    @if (Model.Services != null && Model.Services.Any())
    {
        <div class="row mt-5">
            <div class="col-12">
                <h3 class="mb-4 fw-bold"><i class="fas fa-scissors text-accent me-2"></i> Serviços Disponíveis</h3>
            </div>
        </div>
        <div class="row g-4">
            @foreach (var service in Model.Services.Where(s => s.IsAvailable))
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm service-card transition-hover">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h5 class="card-title fw-bold mb-0 text-dark">
                                    @service.Name
                                </h5>
                                <span class="badge bg-primary text-white rounded-pill px-3 py-2 fs-6">
                                    €@service.Price.ToString("0.00")
                                </span>
                            </div>
                            
                            @if (service.IsHomeService)
                            {
                                <div class="mb-3">
                                    <span class="badge bg-info bg-opacity-10 text-info border border-info rounded-pill">
                                        <i class="fas fa-home me-1"></i> Domicílio
                                    </span>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(service.Description))
                            {
                                <p class="card-text text-secondary mb-4">@service.Description</p>
                            }
                            
                            <div class="mt-auto d-flex align-items-center text-muted">
                                <i class="far fa-clock me-2"></i> 
                                <span class="fw-medium">@service.DurationMinutes minutos</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Reviews Section -->
    <div class="row mt-5 mb-5">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h3 class="fw-bold mb-0"><i class="fas fa-comments text-accent me-2"></i> Comentários</h3>
            </div>

            @if (Model.Reviews != null && Model.Reviews.Any())
            {
                <div class="row g-4">
                    @foreach (var review in Model.Reviews)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 shadow-sm border-0 bg-white">
                                <div class="card-body p-4">
                                    <div class="d-flex align-items-center mb-3">
                                        @if (!string.IsNullOrEmpty(review.ProfilePhotoUrl))
                                        {
                                            <img src="@review.ProfilePhotoUrl" alt="@review.AuthorName" class="rounded-circle me-3" style="width: 48px; height: 48px; object-fit: cover;">
                                        }
                                        else
                                        {
                                            <div class="bg-secondary rounded-circle d-flex align-items-center justify-content-center me-3 text-white fw-bold" style="width: 48px; height: 48px;">
                                                @(review.AuthorName.Length > 0 ? review.AuthorName.Substring(0,1).ToUpper() : "?")
                                            </div>
                                        }
                                        <div>
                                            <h6 class="mb-0 fw-bold">@review.AuthorName</h6>
                                            <small class="text-muted">@review.RelativeTimeDescription</small>
                                        </div>
                                    </div>
                                    
                                    <div class="rating mb-3 text-warning">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= review.Rating)
                                            {
                                                <i class="fas fa-star"></i>
                                            }
                                            else
                                            {
                                                <i class="far fa-star"></i>
                                            }
                                        }
                                    </div>
                                    
                                    <p class="card-text text-secondary" style="font-size: 0.95rem; line-height: 1.6;">
                                        @review.Text
                                    </p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="card shadow-sm border-0 bg-light">
                    <div class="card-body p-5 text-center">
                        <div class="text-muted mb-3">
                            <i class="fas fa-comment-slash fa-3x"></i>
                        </div>
                        <h5 class="fw-bold">Ainda sem avaliações disponíveis</h5>
                        <p class="text-secondary mb-0">Nenhuma avaliação foi encontrada para esta localização.</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ── Details page map (Google Maps JS) ──────────────────────────────
        function initMap() {
            var lat = @Model.Latitude.ToString(System.Globalization.CultureInfo.InvariantCulture);
            var lng = @Model.Longitude.ToString(System.Globalization.CultureInfo.InvariantCulture);
            var location = { lat: lat, lng: lng };
            
            if (lat !== 0 && lng !== 0) {
                var map = new google.maps.Map(document.getElementById('map'), {
                    zoom: 15,
                    center: location
                });
                var marker = new google.maps.Marker({
                    position: location,
                    map: map,
                    title: '@Html.Raw(Model.Name.Replace("'", "\\'"))'
                });
            } else {
                document.getElementById('map').innerHTML = '<div class="d-flex justify-content-center align-items-center h-100 bg-light text-muted">Localização indisponível</div>';
            }
        }

        // ── Embedded in-page Directions ────────────────────────────────────
        // Builds a Google Maps Embed Directions iframe — user stays on BarberLoc.
        var _detailsDirectionsOpen = false;
        var _detailsDestination    = '@Html.Raw(Model.Address?.Replace("'", "\\'") ?? Model.Name.Replace("'", "\\'"))';
        var _detailsApiKey         = document.getElementById('google-maps-api-key')?.value || '';

        function toggleDetailsDirections() {
            var section  = document.getElementById('details-directions-section');
            var iframe   = document.getElementById('details-directions-iframe');
            var loading  = document.getElementById('details-directions-loading');
            var geoErr   = document.getElementById('details-geo-error');
            var btn      = document.getElementById('btn-details-directions');

            _detailsDirectionsOpen = !_detailsDirectionsOpen;

            if (!_detailsDirectionsOpen) {
                section.style.display = 'none';
                iframe.style.display  = 'none';
                iframe.src = '';
                return;
            }

            // Show the section
            section.style.removeProperty('display');
            if (loading) loading.style.display = 'block';
            if (geoErr)  geoErr.classList.add('d-none');
            iframe.style.display = 'none';

            function buildEmbedUrl(originParam) {
                var base = 'https://www.google.com/maps/embed/v1/';
                var url = '';
                if (originParam) {
                    url = base + 'directions?destination=' + encodeURIComponent(_detailsDestination) + '&mode=walking&origin=' + encodeURIComponent(originParam);
                } else {
                    url = base + 'place?q=' + encodeURIComponent(_detailsDestination);
                }
                if (_detailsApiKey) url += '&key=' + encodeURIComponent(_detailsApiKey);
                return url;
            }

            function showIframe(src) {
                iframe.src = src;
                iframe.style.display = 'block';
                if (loading) loading.style.display = 'none';
            }

            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    function(pos) {
                        var origin = pos.coords.latitude + ',' + pos.coords.longitude;
                        showIframe(buildEmbedUrl(origin));
                    },
                    function() {
                        if (geoErr) geoErr.classList.remove('d-none');
                        showIframe(buildEmbedUrl(null));
                    },
                    { timeout: 6000, maximumAge: 60000 }
                );
            } else {
                if (geoErr) geoErr.classList.remove('d-none');
                showIframe(buildEmbedUrl(null));
            }
        }
    </script>
    <script async defer src="https://maps.googleapis.com/maps/api/js?key=@Configuration["GoogleMaps:ApiKey"]&callback=initMap"></script>
}
