@{
    ViewData["Title"] = "Mapa de Barbearias";
    var googleApiKey = ViewData["GoogleApiKey"] as string ?? string.Empty;
}

@* ── Anti-forgery token for authenticated AJAX posts ── *@
@Html.AntiForgeryToken()

<meta name="description" content="Encontre barbearias e salões de beleza perto de si no mapa interativo BarberLoc. Veja avaliações Google, horários, contactos e muito mais." />

<style>
    /*
     * FIX 1 (Markers disappearing): The map container now uses an explicit pixel
     * height instead of calc(100vh - 56px). The previous approach caused the map
     * div to collapse to zero height when the parent container-fluid had no explicit
     * height — resulting in markers being rendered but invisible.
     */
    #map-container {
        position: relative;
        height: 600px;       /* explicit px height — never collapses regardless of parent layout */
        overflow: hidden;
    }

    @@media (min-height: 700px) {
        #map-container {
            height: calc(100vh - 60px);   /* taller viewports get full-height map */
        }
    }

    #map {
        height: 100%;
        width: 100%;
    }

    /* Filter sidebar */
    #filter-sidebar {
        position: absolute;
        top: 12px;
        left: 12px;
        z-index: 10;
        width: 290px;
        max-height: calc(100% - 24px);
        overflow-y: auto;
        border-radius: 1rem;
        box-shadow: 0 4px 24px rgba(0,0,0,.18);
        transition: transform 0.3s ease;
        scrollbar-width: thin;
        scrollbar-color: rgba(0,0,0,.15) transparent;
    }

    #filter-sidebar.collapsed-sidebar {
        transform: translateX(-310px);
    }

    #toggle-sidebar-btn {
        position: absolute;
        top: 12px;
        left: 12px;
        z-index: 11;
        border-radius: 0.75rem;
        box-shadow: 0 2px 10px rgba(0,0,0,.2);
        transition: left 0.3s ease;
    }

    #toggle-sidebar-btn.sidebar-open {
        left: 314px;
    }

    /* Map loading overlay */
    #map-loading {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 20;
        border-radius: 1rem;
    }

    /* Geolocation status indicator */
    #geo-status-badge {
        transition: opacity 0.3s ease;
    }

    /* Radius slider styling */
    #radius-slider-row {
        transition: opacity 0.3s ease, max-height 0.3s ease;
        overflow: hidden;
    }

    #radius-slider-row.geo-disabled {
        opacity: 0.4;
        pointer-events: none;
    }

    #filter-radius {
        accent-color: #4361ee;
    }

    @@media (max-width: 767.98px) {
        #map-container {
            height: 70vh;
            min-height: 400px;
        }
        #filter-sidebar {
            width: calc(100vw - 24px);
            max-height: 55vh;
            top: auto;
            bottom: 12px;
            left: 12px;
            right: 12px;
            transform: none;
        }
        #filter-sidebar.collapsed-sidebar {
            transform: translateY(calc(100% + 20px));
        }
        #toggle-sidebar-btn {
            top: auto;
            bottom: 12px;
            left: auto;
            right: 12px;
        }
        #toggle-sidebar-btn.sidebar-open {
            left: auto;
            bottom: calc(55vh + 20px);
        }
    }
</style>

<div id="map-container">

    @* Google Map *@
    <div id="map"></div>

    @* Map loading overlay *@
    <div id="map-loading" class="bg-white shadow-lg p-4 text-center d-none">
        <div class="spinner-border text-primary mb-2" role="status">
            <span class="visually-hidden">A carregar mapa...</span>
        </div>
        <p class="mb-0 small text-muted">A carregar barbearias...</p>
    </div>

    @* No API key warning *@
    @if (string.IsNullOrWhiteSpace(googleApiKey))
    {
        <div class="position-absolute top-0 start-0 end-0 m-3" style="z-index:30;">
            <div class="alert alert-warning alert-dismissible fade show shadow mb-0" role="alert">
                <i class="fas fa-exclamation-triangle me-2"></i>
                <strong>Chave de API em falta.</strong> Configure <code>Google:ApiKey</code> em <code>appsettings.json</code>.
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    @* Toggle filter sidebar button *@
    <button id="toggle-sidebar-btn" class="btn btn-light sidebar-open" title="Filtros" aria-label="Mostrar/Esconder filtros">
        <i class="fas fa-filter me-1"></i> Filtros
    </button>

    @* Filter sidebar *@
    <div id="filter-sidebar" class="bg-white p-3">
        <h6 class="fw-bold mb-3">
            <i class="fas fa-sliders-h text-primary me-2"></i>Filtrar Resultados
        </h6>

        @* ── Categoria ─────────────────────────────────────────────────────── *@
        <div class="mb-3">
            <label class="form-label small fw-semibold">Categoria</label>
            <div class="d-flex flex-wrap gap-1">
                <button class="btn btn-sm btn-outline-primary filter-btn active" data-filter="category" data-value="">Todos</button>
                <button class="btn btn-sm btn-outline-primary filter-btn" data-filter="category" data-value="Barbershop">Barbearia</button>
                <button class="btn btn-sm btn-outline-primary filter-btn" data-filter="category" data-value="HairSalon">Cabeleireiro</button>
                <button class="btn btn-sm btn-outline-primary filter-btn" data-filter="category" data-value="Unisex">Unisexo</button>
            </div>
        </div>

        @* ── Avaliação Mínima ─────────────────────────────────────────────── *@
        <div class="mb-3">
            <label class="form-label small fw-semibold">Avaliação Mínima</label>
            <div class="d-flex flex-wrap gap-1">
                <button class="btn btn-sm btn-outline-warning filter-btn active" data-filter="minRating" data-value="">Qualquer</button>
                <button class="btn btn-sm btn-outline-warning filter-btn" data-filter="minRating" data-value="3">3+ <i class="fas fa-star"></i></button>
                <button class="btn btn-sm btn-outline-warning filter-btn" data-filter="minRating" data-value="4">4+ <i class="fas fa-star"></i></button>
                <button class="btn btn-sm btn-outline-warning filter-btn" data-filter="minRating" data-value="4.5">4.5+ <i class="fas fa-star"></i></button>
            </div>
        </div>

        @* ── Serviço ao Domicílio ─────────────────────────────────────────── *@
        <div class="mb-3">
            <label class="form-label small fw-semibold">Tipo de Serviço</label>
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" role="switch"
                       id="filter-mobile" value="1">
                <label class="form-check-label small fw-medium" for="filter-mobile">
                    <i class="fas fa-home text-info me-1"></i>
                    Apenas ao Domicílio
                    <span class="badge bg-info text-dark ms-1" style="font-size: 0.6rem;">NOVO</span>
                </label>
            </div>
        </div>

        @* ── Distância / Raio ─────────────────────────────────────────────── *@
        <div class="mb-3" id="radius-slider-row">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <label class="form-label small fw-semibold mb-0" for="filter-radius">
                    <i class="fas fa-location-arrow text-primary me-1"></i>
                    Raio de Pesquisa
                </label>
                <span id="radius-label" class="badge bg-primary" style="font-size:0.7rem;">10 km</span>
            </div>
            <input type="range" class="form-range" id="filter-radius"
                   min="1" max="50" step="1" value="10"
                   aria-label="Raio de pesquisa em quilómetros">
            @* Geolocation status indicator *@
            <div id="geo-status-badge" class="mt-1">
                <small id="geo-status-text" class="text-muted" style="font-size: 0.7rem;">
                    <i class="fas fa-location-dot me-1"></i>
                    <span id="geo-status-msg">A aguardar localização...</span>
                </small>
            </div>
        </div>

        <hr class="my-2">
        <div class="d-flex justify-content-between align-items-center">
            <small class="text-muted" id="results-count">A carregar...</small>
            <button class="btn btn-sm btn-outline-secondary" id="btn-reset-filters">
                <i class="fas fa-undo me-1"></i>Limpar
            </button>
        </div>
    </div>

</div>

@* Place detail offcanvas panel *@
@await Html.PartialAsync("_PlaceDetailPanel")

@section Scripts {
    <script>
        // ── Config passed from server to JS ───────────────────────────────────────
        // The API key is NOT included here — it is only used in the <script src> tag.
        window.BarberLocConfig = {
            isAuthenticated: @(User.Identity?.IsAuthenticated == true ? "true" : "false"),
            antiForgeryToken: document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '',
            defaultLat: 38.7169,
            defaultLng: -9.1399
        };

        // ── Geolocation module-scope state ────────────────────────────────────────
        // Stored here (not in barbershops-map.js) so the server-owned filter panel
        // can read user coordinates and inject them into the GetMapData query.
        window.BarberLocGeo = {
            userLat: null,
            userLng: null,
            granted: false
        };

        // ── Geolocation request + radius slider wiring ────────────────────────────
        // Runs once on DOM ready, independent of Google Maps loading.
        document.addEventListener('DOMContentLoaded', function () {
            const radiusRow   = document.getElementById('radius-slider-row');
            const radiusSlider = document.getElementById('filter-radius');
            const radiusLabel  = document.getElementById('radius-label');
            const geoStatusMsg = document.getElementById('geo-status-msg');
            const radiusSliderRowEl = document.getElementById('radius-slider-row');

            // ── Update radius label on slider change ─────────────────────────────
            if (radiusSlider) {
                radiusSlider.addEventListener('input', function () {
                    if (radiusLabel) radiusLabel.textContent = this.value + ' km';
                    // Trigger a map reload if we already have coordinates
                    if (window.BarberLocGeo.granted) {
                        debouncedFetchAndRender();
                    }
                });
            }

            // ── Request geolocation ───────────────────────────────────────────────
            if (navigator.geolocation) {
                radiusSliderRowEl?.classList.add('geo-disabled');

                navigator.geolocation.getCurrentPosition(
                    function (position) {
                        // ✅ Permission granted
                        window.BarberLocGeo.userLat = position.coords.latitude;
                        window.BarberLocGeo.userLng = position.coords.longitude;
                        window.BarberLocGeo.granted = true;

                        radiusSliderRowEl?.classList.remove('geo-disabled');
                        if (geoStatusMsg) {
                            geoStatusMsg.innerHTML = '<i class="fas fa-circle-check text-success me-1"></i>Localização obtida';
                        }

                        // Re-fetch markers now that we have coordinates and a radius
                        fetchAndRender();
                    },
                    function (error) {
                        // ❌ Permission denied or unavailable
                        window.BarberLocGeo.granted = false;
                        radiusSliderRowEl?.classList.add('geo-disabled');
                        if (geoStatusMsg) {
                            geoStatusMsg.innerHTML = '<i class="fas fa-ban text-danger me-1"></i>Localização não disponível — a mostrar todos';
                        }
                        // Still load all markers without distance filtering
                        fetchAndRender();
                    },
                    { timeout: 8000, maximumAge: 300000 }
                );
            } else {
                // Browser doesn't support geolocation
                radiusSliderRowEl?.classList.add('geo-disabled');
                if (geoStatusMsg) {
                    geoStatusMsg.innerHTML = '<i class="fas fa-ban text-secondary me-1"></i>Geolocalização não suportada';
                }
            }

            // ── Home-Service toggle re-fetch ─────────────────────────────────────
            const mobileCb = document.getElementById('filter-mobile');
            if (mobileCb) {
                mobileCb.addEventListener('change', function () {
                    fetchAndRender();
                });
            }

            // ── Reset button ─────────────────────────────────────────────────────
            const resetBtn = document.getElementById('btn-reset-filters');
            if (resetBtn) {
                resetBtn.addEventListener('click', function () {
                    // Reset filter chips
                    document.querySelectorAll('.filter-btn').forEach(function (b) {
                        b.classList.toggle('active', b.dataset.value === '');
                    });
                    // Reset mobile toggle
                    if (mobileCb) mobileCb.checked = false;
                    // Reset radius slider
                    if (radiusSlider) {
                        radiusSlider.value = 10;
                        if (radiusLabel) radiusLabel.textContent = '10 km';
                    }
                    fetchAndRender();
                });
            }
        });

        // ── Build the GetMapData query string from all active filters ─────────────
        function buildQueryString() {
            const geo      = window.BarberLocGeo;
            const mobileCb = document.getElementById('filter-mobile');
            const radiusEl = document.getElementById('filter-radius');

            const params = new URLSearchParams();

            // Distance / geolocation filter
            if (geo.granted && geo.userLat != null && geo.userLng != null) {
                params.set('lat',      geo.userLat.toString());
                params.set('lng',      geo.userLng.toString());
                params.set('radiusKm', radiusEl ? radiusEl.value : '10');
            }

            // Home-service toggle
            if (mobileCb && mobileCb.checked) {
                params.set('mobileOnly', 'true');
            }

            return params.toString() ? '/Barbershops/GetMapData?' + params.toString()
                                     : '/Barbershops/GetMapData';
        }

        // ── Fetch barbershops from server and render via barbershops-map.js ────────
        // barbershops-map.js exposes window.BarberLocMapBridge for external callers.
        async function fetchAndRender() {
            const url = buildQueryString();
            try {
                const resp = await fetch(url);
                if (!resp.ok) throw new Error('HTTP ' + resp.status);
                const places = await resp.json();

                // Apply client-side category + rating filters (handled in barbershops-map.js)
                if (typeof window.BarberLocMapBridge?.receiveServerData === 'function') {
                    window.BarberLocMapBridge.receiveServerData(places);
                }
                // Update result count
                const countEl = document.getElementById('results-count');
                if (countEl) countEl.textContent = places.length + ' resultado' + (places.length !== 1 ? 's' : '');
            } catch (err) {
                console.error('[BarberLoc] fetchAndRender error:', err);
            }
        }

        // Debounce so slider drags don't fire 50 XHR requests
        let _fetchTimer = null;
        function debouncedFetchAndRender() {
            clearTimeout(_fetchTimer);
            _fetchTimer = setTimeout(fetchAndRender, 350);
        }

        // Make fetchAndRender globally accessible for barbershops-map.js
        window.BarberLocFetchAndRender = fetchAndRender;
    </script>

    @*
        FIX 1 + 2: Script loading order is critical.

        Step 1 — load barbershops-map.js FIRST, synchronously (no async/defer).
                  This guarantees window.initMap is defined before the Maps API fires.

        Step 2 — load the Google Maps JS API with:
                  • callback=initMap  (fires after API is ready, by which time initMap is defined)
                  • async defer       (non-blocking page load)
                  • NO `libraries=marker` — mixing the AdvancedMarkers library with legacy
                    google.maps.Marker causes silent click listener failures.
                  • NO `loading=async` — this parameter conflicts with the async+defer attrs.

        Using a static <script src> tag (not dynamically injected via createElement)
        eliminates the race condition where the callback fires before the src is added to the DOM.
    *@
    <script src="~/js/barbershops-map.js" asp-append-version="true"></script>

    @if (!string.IsNullOrWhiteSpace(googleApiKey))
    {
        <script src="https://maps.googleapis.com/maps/api/js?key=@googleApiKey&libraries=marker&callback=initMap" async defer></script>
    }
}