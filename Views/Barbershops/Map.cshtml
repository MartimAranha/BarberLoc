@{
    ViewData["Title"] = "Mapa de Barbearias";
}

<div class="container-fluid px-0">
    <div class="row g-0">
        <!-- Sidebar / Filter Panel -->
        <div class="col-md-3 p-3 bg-light border-end" style="height: calc(100vh - 56px); overflow-y: auto;">
            <h4 class="mb-4"><i class="fas fa-map-marked-alt text-primary"></i> Explorar Mapa</h4>
            
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h6 class="card-subtitle mb-3 text-success"><i class="fas fa-map-marked-alt"></i> Barbearias Reais</h6>
                    <p class="small text-muted">
                        Os dados são obtidos em tempo real do <strong>OpenStreetMap</strong>, 
                        a mesma fonte usada por aplicações como Google Maps.
                    </p>
                    <div class="alert alert-light small mb-0">
                        <i class="fas fa-info-circle"></i> Mostrando até 200 barbearias em Portugal
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Legenda</h6>
                    <ul class="list-unstyled small">
                        <li><span class="badge bg-success rounded-circle p-1 me-2"> </span> Barbearia Real (OpenStreetMap)</li>
                    </ul>
                    <div class="alert alert-success small mb-0 mt-3">
                        <i class="fas fa-map-marked-alt"></i> Todas as barbearias mostradas são <strong>reais</strong> e vêm diretamente do OpenStreetMap!
                    </div>
                </div>
            </div>
            
            <div id="locationsList" class="mt-4">
                <!-- List of visible locations will be populated here -->
            </div>
        </div>

        <!-- Map Container -->
        <div class="col-md-9 position-relative">
            <div id="map" style="height: calc(100vh - 56px); width: 100%;"></div>
            
            <!-- Loading Overlay -->
            <div id="mapLoading" class="position-absolute top-50 start-50 translate-middle bg-white p-3 rounded shadow" style="z-index: 1000;">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                Loading Map Data...
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    
    <style>
        .custom-marker {
            display: flex;
            justify-content: center;
            align-items: center;
            border-radius: 50%;
            border: 2px solid white;
            box-shadow: 0 2px 5px rgba(0,0,0,0.3);
            color: white;
            font-size: 14px;
        }
        .marker-barbershop { background-color: #2c3e50; } /* Primary */
        .marker-hairsalon { background-color: #e74c3c; } /* Secondary/Danger */
        .marker-unisex { background-color: #f39c12; } /* Warning */
        .marker-osm { background-color: #27ae60; } /* Green for OSM discovered */
    </style>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Initialize Map (Center on Portugal)
            var map = L.map('map').setView([39.5, -8.0], 7);
            
            L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
            }).addTo(map);

            var allMarkers = [];
            var locations = [];
            var osmBarbershops = [];

            // Custom Icon Function
            function createCustomIcon(category, isFromDatabase = true) {
                var className = 'custom-marker ';
                var iconClass = 'fa-cut';
                
                if (!isFromDatabase) {
                    // OSM discovered barbershops - use green color
                    className += 'marker-osm';
                    iconClass = 'fa-map-marker';
                } else if (category === 'Barbershop') {
                    className += 'marker-barbershop';
                } else if (category === 'HairSalon') {
                    className += 'marker-hairsalon';
                    iconClass = 'fa-female';
                } else {
                    className += 'marker-unisex';
                    iconClass = 'fa-venus-mars';
                }

                return L.divIcon({
                    className: 'custom-icon-container',
                    html: `<div class="${className}" style="width: 30px; height: 30px;"><i class="fas ${iconClass}"></i></div>`,
                    iconSize: [30, 30],
                    iconAnchor: [15, 15],
                    popupAnchor: [0, -15]
                });
            }

            // Fetch Barbershops from OpenStreetMap (Overpass API)
            function fetchOSMBarbershops() {
                // Query for barbershops and hairdressers in Portugal
                const overpassQuery = `
                    [out:json][timeout:25];
                    area["ISO3166-1"="PT"][admin_level=2];
                    (
                        node["shop"="hairdresser"](area);
                        node["shop"="barber"](area);
                        way["shop"="hairdresser"](area);
                        way["shop"="barber"](area);
                    );
                    out center 200;
                `;
                
                const overpassUrl = 'https://overpass-api.de/api/interpreter';
                
                fetch(overpassUrl, {
                    method: 'POST',
                    body: overpassQuery
                })
                .then(response => response.json())
                .then(data => {
                    console.log(`Found ${data.elements.length} barbershops from OpenStreetMap`);
                    
                    data.elements.forEach(element => {
                        var lat, lng, name, address;
                        
                        if (element.type === 'node') {
                            lat = element.lat;
                            lng = element.lon;
                        } else if (element.center) {
                            lat = element.center.lat;
                            lng = element.center.lon;
                        }
                        
                        name = element.tags.name || 'Barbearia/Salão (OSM)';
                        address = [
                            element.tags['addr:street'],
                            element.tags['addr:housenumber'],
                            element.tags['addr:city']
                        ].filter(Boolean).join(', ') || 'Endereço não disponível';
                        
                        var marker = L.marker([lat, lng], {
                            icon: createCustomIcon('OSM', false),
                            category: 'OSM'
                        });

                        var popupContent = `
                            <div class="text-center">
                                <h6>${name}</h6>
                                <div class="mb-1"><span class="badge bg-success">Descoberto em OSM</span></div>
                                <p class="small mb-2">${address}</p>
                                <div class="small text-muted">
                                    ${element.tags.phone ? '<i class="fas fa-phone"></i> ' + element.tags.phone + '<br>' : ''}
                                    ${element.tags.website ? '<a href="' + element.tags.website + '" target="_blank">Website</a>' : ''}
                                </div>
                            </div>
                        `;
                        
                        marker.bindPopup(popupContent);
                        marker.addTo(map);
                        allMarkers.push(marker);
                        osmBarbershops.push({lat, lng, name, address});
                    });
                    
                    console.log('OSM barbershops loaded on map');
                })
                .catch(error => {
                    console.error('Error loading OSM data:', error);
                });
            }

            // Only fetch real barbershops from OpenStreetMap (no database data)
            document.getElementById('mapLoading').innerHTML = '<div class="spinner-border text-success" role="status"></div> Carregando barbearias reais do OpenStreetMap...';
            
            // Fetch OSM barbershops
            fetchOSMBarbershops();
            
            // Hide loading after a delay
            setTimeout(() => {
                document.getElementById('mapLoading').style.display = 'none';
            }, 5000);

            // Filter Logic
            var checkAll = document.getElementById('checkAll');
            var categoryFilters = document.querySelectorAll('.category-filter');

            function updateFilters() {
                var selectedCategories = [];
                categoryFilters.forEach(cb => {
                    if (cb.checked) selectedCategories.push(cb.value);
                });

                allMarkers.forEach(marker => {
                    var category = marker.options.category;
                    if (selectedCategories.includes(category) || category === 'OSM') {
                        map.addLayer(marker);
                    } else {
                        map.removeLayer(marker);
                    }
                });
            }

            checkAll.addEventListener('change', function() {
                var isChecked = this.checked;
                categoryFilters.forEach(cb => {
                    cb.checked = isChecked;
                });
                updateFilters();
            });

            categoryFilters.forEach(cb => {
                cb.addEventListener('change', function() {
                    var allChecked = true;
                    categoryFilters.forEach(c => { if(!c.checked) allChecked = false; });
                    checkAll.checked = allChecked;
                    
                    updateFilters();
                });
            });
        });
    </script>
}
