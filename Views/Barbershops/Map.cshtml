@{
    ViewData["Title"] = "Mapa de Barbearias";
}

<div class="container-fluid px-0">
    <div class="row g-0">
        <!-- Sidebar / Filter Panel -->
        <div class="col-md-3 p-3 bg-light border-end" style="height: calc(100vh - 56px); overflow-y: auto;">
            <h4 class="mb-4"><i class="fas fa-map-marked-alt text-primary"></i> Explorar Mapa</h4>
            
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h6 class="card-subtitle mb-3 text-muted">Filtros</h6>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" id="checkAll" checked>
                        <label class="form-check-label" for="checkAll">Selecionar Todos</label>
                    </div>
                    <hr>
                    <div class="form-check mb-2">
                        <input class="form-check-input category-filter" type="checkbox" value="barbershop" id="filterBarber" checked>
                        <label class="form-check-label" for="filterBarber">Barbearias</label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input category-filter" type="checkbox" value="hair_care" id="filterSalon" checked>
                        <label class="form-check-label" for="filterSalon">Cabeleireiros</label>
                    </div>
                    <div class="form-check mb-2">
                        <input class="form-check-input category-filter" type="checkbox" value="database" id="filterPartner" checked>
                        <label class="form-check-label" for="filterPartner">Parceiros BarberLoc</label>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <h6 class="card-subtitle mb-2 text-muted">Legenda</h6>
                    <ul class="list-unstyled small mb-0">
                        <li class="mb-1"><span class="badge bg-primary rounded-circle p-1 me-2" style="width: 12px; height: 12px; display: inline-block;"> </span> Resultados Google (Real)</li>
                        <li><span class="badge bg-dark rounded-circle p-1 me-2" style="width: 12px; height: 12px; display: inline-block;"> </span> Parceiros (Base de Dados)</li>
                    </ul>
                </div>
            </div>
            
            <div id="locationsList" class="mt-4">
                <!-- List of visible locations will be populated here -->
            </div>
        </div>

        <!-- Map Container -->
        <div class="col-md-9 position-relative">
            <div id="map" style="height: calc(100vh - 56px); width: 100%;"></div>
            
            <!-- Loading Overlay -->
            <div id="mapLoading" class="position-absolute top-50 start-50 translate-middle bg-white p-3 rounded shadow" style="z-index: 1000;">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                Pesquisando barbearias reais...
            </div>
            
            <!-- Search Bar Over Map -->
            <div class="position-absolute top-0 start-50 translate-middle-x mt-3" style="z-index: 1000; width: 300px;">
                <div class="input-group shadow">
                    <input id="pac-input" type="text" class="form-control" placeholder="Pesquisar localidade...">
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Replace 'YOUR_API_KEY' with your actual Google Maps API Key -->
    <script src="https://maps.googleapis.com/maps/api/js?key=YOUR_API_KEY&libraries=places&language=pt"></script>
    
    <script>
        let map;
        let service;
        let infowindow;
        let markers = [];
        let dbMarkers = [];
        let searchTimeout;

        function initMap() {
            // Default center at Portugal
            const portugal = { lat: 39.5, lng: -8.0 };
            map = new google.maps.Map(document.getElementById("map"), {
                zoom: 7,
                center: portugal,
                mapTypeControl: false,
                streetViewControl: false,
                fullscreenControl: false,
                styles: [
                    {
                        "featureType": "poi.business",
                        "stylers": [{ "visibility": "off" }]
                    }
                ]
            });

            infowindow = new google.maps.InfoWindow();
            service = new google.maps.places.PlacesService(map);

            // Bounds Change Event: Search when map stops moving
            map.addListener("idle", () => {
                clearTimeout(searchTimeout);
                searchTimeout = setTimeout(searchNearbyBarbershops, 500);
            });

            // Initialize Search Box
            const input = document.getElementById("pac-input");
            const searchBox = new google.maps.places.SearchBox(input);
            map.addListener("bounds_changed", () => {
                searchBox.setBounds(map.getBounds());
            });

            searchBox.addListener("places_changed", () => {
                const places = searchBox.getPlaces();
                if (places.length == 0) return;
                
                const bounds = new google.maps.LatLngBounds();
                places.forEach((place) => {
                    if (!place.geometry || !place.geometry.location) return;
                    if (place.geometry.viewport) {
                        bounds.union(place.geometry.viewport);
                    } else {
                        bounds.extend(place.geometry.location);
                    }
                });
                map.fitBounds(bounds);
            });

            // Initial Database Fetch
            fetchDatabaseBarbershops();

            // Set up UI listeners
            setupUIListeners();
        }

        function searchNearbyBarbershops() {
            if (map.getZoom() < 12) {
                document.getElementById('mapLoading').innerHTML = '<i class="fas fa-search-plus"></i> Aumente o zoom para pesquisar';
                document.getElementById('mapLoading').style.display = 'block';
                return;
            }

            document.getElementById('mapLoading').innerHTML = '<div class="spinner-border spinner-border-sm text-primary"></div> Pesquisando...';
            document.getElementById('mapLoading').style.display = 'block';

            const request = {
                bounds: map.getBounds(),
                type: ['barber', 'beauty_salon', 'hair_care']
            };

            service.nearbySearch(request, (results, status) => {
                if (status === google.maps.places.PlacesServiceStatus.OK && results) {
                    clearMarkers();
                    for (let i = 0; i < results.length; i++) {
                        createMarker(results[i]);
                    }
                }
                document.getElementById('mapLoading').style.display = 'none';
                updateSidebar();
            });
        }

        function createMarker(place) {
            if (!place.geometry || !place.geometry.location) return;

            const marker = new google.maps.Marker({
                map,
                position: place.geometry.location,
                title: place.name,
                icon: {
                    url: 'https://maps.google.com/mapfiles/ms/icons/blue-dot.png'
                },
                category: 'google'
            });

            google.maps.event.addListener(marker, "click", () => {
                const content = `
                    <div class="p-2">
                        <h6 class="mb-1">${place.name}</h6>
                        <p class="small text-muted mb-1">${place.vicinity || ""}</p>
                        ${place.rating ? `<div class="mb-1"><span class="badge bg-primary">${place.rating} ★</span></div>` : ""}
                        <div class="alert alert-info py-1 px-2 mb-0 small" style="font-size: 0.7rem;">
                            Fonte: Google Maps
                        </div>
                    </div>
                `;
                infowindow.setContent(content);
                infowindow.open(map, marker);
            });

            markers.push({ 
                marker, 
                data: {
                    name: place.name,
                    address: place.vicinity,
                    rating: place.rating,
                    isGoogle: true
                }
            });
        }

        function fetchDatabaseBarbershops() {
            fetch('/Barbershops/GetMapData')
                .then(response => response.json())
                .then(data => {
                    data.forEach(item => {
                        const marker = new google.maps.Marker({
                            position: { lat: item.lat, lng: item.lng },
                            map,
                            title: item.name,
                            icon: {
                                url: 'https://maps.google.com/mapfiles/ms/icons/black-dot.png'
                            }
                        });

                        google.maps.event.addListener(marker, "click", () => {
                            const content = `
                                <div class="text-center p-2">
                                    <h6 class="mb-1">${item.name}</h6>
                                    <p class="small text-muted mb-2">${item.address}</p>
                                    <div class="mb-2">
                                        <span class="badge bg-warning text-dark">${item.rating.toFixed(1)} <i class="fas fa-star"></i></span>
                                    </div>
                                    <a href="/Barbershops/Details/${item.id}" class="btn btn-sm btn-primary">Ver e Reservar</a>
                                </div>
                            `;
                            infowindow.setContent(content);
                            infowindow.open(map, marker);
                        });

                        dbMarkers.push({ 
                            marker, 
                            data: {
                                name: item.name,
                                address: item.address,
                                rating: item.rating,
                                id: item.id,
                                isGoogle: false
                            }
                        });
                    });
                });
        }

        function clearMarkers() {
            markers.forEach(m => m.marker.setMap(null));
            markers = [];
        }

        function updateSidebar() {
            const listContainer = document.getElementById('locationsList');
            listContainer.innerHTML = '';
            
            const bounds = map.getBounds();
            let visibleCount = 0;

            const allResults = [...dbMarkers, ...markers];
            
            allResults.forEach(item => {
                if (bounds && bounds.contains(item.marker.getPosition())) {
                    const isGoogleFilter = document.getElementById('checkAll').checked || (item.data.isGoogle && (document.getElementById('filterBarber').checked || document.getElementById('filterSalon').checked));
                    const isDbFilter = document.getElementById('checkAll').checked || (!item.data.isGoogle && document.getElementById('filterPartner').checked);
                    
                    if (isGoogleFilter || isDbFilter) {
                        visibleCount++;
                        if (visibleCount > 25) return;

                        const itemDiv = document.createElement('div');
                        itemDiv.className = 'card mb-2 shadow-sm border-0';
                        itemDiv.style.cursor = 'pointer';
                        
                        const badgeClass = item.data.isGoogle ? 'bg-primary' : 'bg-dark';
                        const sourceName = item.data.isGoogle ? 'Google' : 'Parceiro';

                        itemDiv.innerHTML = `
                            <div class="card-body p-2">
                                <div class="d-flex justify-content-between align-items-start">
                                    <h6 class="mb-0 small fw-bold">${item.data.name}</h6>
                                    <span class="badge ${badgeClass}" style="font-size: 0.6rem;">${sourceName}</span>
                                </div>
                                <p class="mb-0 text-muted" style="font-size: 0.75rem;">${item.data.address || "Endereço indisponível"}</p>
                            </div>
                        `;
                        
                        itemDiv.onclick = () => {
                            map.panTo(item.marker.getPosition());
                            google.maps.event.trigger(item.marker, 'click');
                        };
                        
                        listContainer.appendChild(itemDiv);
                    }
                }
            });

            if (visibleCount === 0) {
                listContainer.innerHTML = '<div class="text-center text-muted small mt-4">Nenhum resultado visível nesta área</div>';
            }
        }

        function setupUIListeners() {
            const checkAll = document.getElementById('checkAll');
            const filters = document.querySelectorAll('.category-filter');

            checkAll.addEventListener('change', function() {
                filters.forEach(cb => cb.checked = this.checked);
                updateFilters();
            });

            filters.forEach(cb => {
                cb.addEventListener('change', () => {
                    checkAll.checked = Array.from(filters).every(f => f.checked);
                    updateFilters();
                });
            });
        }

        function updateFilters() {
            const filterBarber = document.getElementById('filterBarber').checked;
            const filterSalon = document.getElementById('filterSalon').checked;
            const filterPartner = document.getElementById('filterPartner').checked;
            const checkAll = document.getElementById('checkAll').checked;

            // Simple logic for this implementation:
            // Partners: black dots
            dbMarkers.forEach(m => m.marker.setMap((checkAll || filterPartner) ? map : null));
            
            // Google Results: blue dots (barber/salon)
            markers.forEach(m => m.marker.setMap((checkAll || filterBarber || filterSalon) ? map : null));
            
            updateSidebar();
        }

        // Load visual representation of map
        window.onload = initMap;
    </script>
}
