@{
    ViewData["Title"] = "Mapa de Barbearias";
}

<div class="container-fluid px-0">
    <div class="row g-0">
        <div class="col-md-3 p-3 bg-light border-end" style="height: calc(100vh - 56px); overflow-y: auto;">
            <h4><i class="fas fa-map-marked-alt text-primary"></i> Explorar Mapa</h4>
            <div id="locationsList" class="mt-4"></div>
        </div>

        <div class="col-md-9 position-relative">
            <div id="map" style="height: calc(100vh - 56px); width: 100%;"></div>
            <div id="mapLoading" class="position-absolute top-50 start-50 translate-middle bg-white p-3 rounded shadow" style="display: none; z-index: 1000;">
                <div class="spinner-border text-primary" role="status"></div> Pesquisando...
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        var gkey = ViewData["GoogleApiKey"] as string ?? "";
    }

    <script>
        // Esta função É OBRIGATÓRIA para o Google Maps
        window.initMap = function() {
            console.log("Google Maps carregado e initMap chamado!");
            
            const map = new google.maps.Map(document.getElementById("map"), {
                zoom: 12,
                center: { lat: 38.7223, lng: -9.1393 } // Lisboa
            });

            // Chama a função que vais ter no teu barbershops-map.js
            if (typeof loadBarbershops === 'function') {
                loadBarbershops(map);
            } else {
                console.error("A função loadBarbershops não foi encontrada no barbershops-map.js!");
            }
        };

        (function() {
            var renderedKey = '@gkey';
            if (!renderedKey || renderedKey.includes('YOUR_')) {
                console.error('Chave de API inválida.');
                return;
            }

            // Injeta o script do Google Maps com a callback=initMap
            var script = document.createElement('script');
            script.src = 'https://maps.googleapis.com/maps/api/js?key=' + encodeURIComponent(renderedKey) + '&callback=initMap';
            script.async = true;
            script.defer = true;
            document.head.appendChild(script);
        })();
    </script>
    
    <script src="~/js/barbershops-map.js"></script>
}