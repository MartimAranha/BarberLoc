@model IEnumerable<WebApplication1.Models.Barbershop>

@{
    ViewData["Title"] = "Barbearias";
}

<div class="container my-5">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <h1 class="section-title"><i class="fas fa-scissors text-primary"></i> Sobre o BarberLoc</h1>
            <p class="lead mt-2">O BarberLoc ajuda-o a encontrar, reservar e gerir serviços de barbearia e cabeleireiro perto de si — de forma rápida e confiável.</p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h4 class="mb-3">O que pode fazer com esta aplicação</h4>
                    <ul class="list-unstyled">
                        <li class="mb-2"><i class="fas fa-map-marker-alt text-accent me-2"></i><strong>Localizar</strong> barbearias e cabeleireiros na sua área com mapas e direcções.</li>
                        <li class="mb-2"><i class="fas fa-calendar-plus text-accent me-2"></i><strong>Reservar</strong> um horário para o serviço que pretende, com confirmação pela barbearia.</li>
                        <li class="mb-2"><i class="fas fa-motorcycle text-accent me-2"></i><strong>Serviço ao domicílio</strong> disponível quando indicado pela barbearia (taxa extra aplicável).</li>
                        <li class="mb-2"><i class="fas fa-star text-accent me-2"></i><strong>Avaliações</strong> para ajudar a escolher o melhor profissional.</li>
                        <li class="mb-2"><i class="fas fa-user-cog text-accent me-2"></i><strong>Gestão de perfil</strong> para atualizar os seus dados e contactos.</li>
                    </ul>

                    <h5 class="mt-4">Como começar</h5>
                    <ol>
                        <li>Crie uma conta ou entre com Google.</li>
                        <li>Pesquise por barbearias ou navegue pelo mapa.</li>
                        <li>Escolha um serviço, seleccione data e hora e confirme a reserva.</li>
                    </ol>

                    <h5 class="mt-4">Ajuda e contacto</h5>
                    <p class="text-muted">Se tiver problemas ou dúvidas, contacte-nos através do email <a href="mailto:support@barberloc.example">support@barberloc.example</a> ou visite a secção de perfil para actualizar os seus dados.</p>

                    <div class="d-flex gap-2 mt-3">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">Voltar à Página Inicial</a>
                        <a asp-action="Map" asp-controller="Barbershops" class="btn btn-primary">Ver Mapa</a>
                    </div>
                </div>
            </div>
        </div>
    </div>


</div>
