@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        @{
            var user = await UserManager.GetUserAsync(User);
            var displayName = user?.FullName ?? User.Identity?.Name ?? "Utilizador";
        }
        <a class="nav-link" asp-controller="Profile" asp-action="Index" title="Manage">
            <i class="fas fa-user-circle"></i> Olá, @displayName!
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-danger fw-medium" asp-controller="Favorites" asp-action="Index">
            <i class="fas fa-heart"></i> Favoritos
        </a>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="nav-link btn btn-link">
                <i class="fas fa-sign-out-alt"></i> Sair
            </button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Register">
            <i class="fas fa-user-plus"></i> Registar
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">
            <i class="fas fa-sign-in-alt"></i> Entrar
        </a>
    </li>
}
</ul>
