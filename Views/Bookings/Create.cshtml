@model WebApplication1.Models.Booking

@{
    ViewData["Title"] = "Criar Reserva";
    var barbershop = ViewBag.Barbershop as WebApplication1.Models.Barbershop;
    var services = ViewBag.Services as List<WebApplication1.Models.Service>;
}

<div class="container my-5">
    <div class="row mb-3">
        <div class="col-12">
            <a asp-controller="Barbershops" asp-action="Details" asp-route-id="@barbershop?.Id" class="btn btn-outline-primary">
                <i class="fas fa-arrow-left"></i> Voltar
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-custom">
                <div class="card-body p-4">
                    <h2 class="card-title mb-4 text-center">
                        <i class="fas fa-calendar-plus text-accent"></i> Criar Reserva
                    </h2>

                    @if (barbershop != null)
                    {
                        <div class="alert alert-info">
                            <h5><i class="fas fa-store"></i> @barbershop.Name</h5>
                            <p class="mb-0"><i class="fas fa-map-marker-alt"></i> @barbershop.Address</p>
                            @if (!string.IsNullOrEmpty(barbershop.PhoneNumber))
                            {
                                <p class="mb-0 mt-1">
                                    <i class="fas fa-phone"></i>
                                    <a href="tel:@barbershop.PhoneNumber" class="text-dark fw-bold">@barbershop.PhoneNumber</a>
                                </p>
                            }
                        </div>
                    }

                    <form asp-action="Create" method="post" id="bookingForm">
                        @Html.HiddenFor(model => model.BarbershopId)
                        <input type="hidden" id="userLat" name="userLat" />
                        <input type="hidden" id="userLng" name="userLng" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="mb-3">
                            <label asp-for="ServiceId" class="form-label">
                                <i class="fas fa-scissors"></i> Serviço (Opcional)
                            </label>
                            <select asp-for="ServiceId" class="form-select">
                                <option value="">-- Selecione um serviço (opcional) --</option>
                                @if (services != null)
                                {
                                    @foreach (var service in services)
                                    {
                                        <option value="@service.Id">
                                            @service.Name - €@service.Price.ToString("0.00") (@service.DurationMinutes min)
                                        </option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="ServiceId" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="BookingDate" class="form-label">
                                <i class="fas fa-calendar"></i> Data da Reserva*
                            </label>
                            <input asp-for="BookingDate" type="date" class="form-control" 
                                   min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="BookingDate" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="BookingTime" class="form-label">
                                <i class="fas fa-clock"></i> Hora da Reserva*
                            </label>
                            <input asp-for="BookingTime" type="time" class="form-control" />
                            <span asp-validation-for="BookingTime" class="text-danger"></span>
                            <small class="form-text text-muted">
                                Horário de funcionamento: @(barbershop?.OpeningHours ?? "Consulte a barbearia")
                            </small>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Notes" class="form-label">
                                <i class="fas fa-sticky-note"></i> Notas Adicionais
                            </label>
                            <textarea asp-for="Notes" class="form-control" rows="4" 
                                      placeholder="Escreva aqui qualquer informação adicional (preferências, solicitações especiais, etc.)"></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <!-- Serviço ao Domicílio -->
                            <div class="mb-4">
                                <div class="card border-2 border-warning" id="onSiteCard">
                                    <div class="card-body">
                                        <div class="form-check form-switch d-flex align-items-center gap-3">
                                            <input class="form-check-input" type="checkbox" role="switch" 
                                                   asp-for="IsOnSite" id="isOnSiteToggle" name="IsOnSite" style="width:3em; height:1.5em;">
                                            <div>
                                                <label class="form-check-label fw-bold fs-6" for="isOnSiteToggle">
                                                    <i class="fas fa-motorcycle text-warning me-2"></i> Serviço ao Domicílio
                                                </label>
                                                <div class="small text-muted">O profissional desloca-se até à tua morada</div>
                                            </div>
                                        </div>

                                        <div id="onSiteDetails" class="mt-3 d-none">
                                            <div class="alert alert-warning mb-2">
                                                <i class="fas fa-info-circle me-2"></i>
                                                <span id="travelFeeEstimate">A calcular distância e taxa de deslocação...</span>
                                            </div>
                                            <div class="mb-2">
                                                <label class="form-label small fw-semibold">A tua morada para o serviço</label>
                                                <input type="text" class="form-control" id="onSiteAddress" 
                                                       placeholder="Rua, número, cidade..." />
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-check"></i> Confirmar Reserva
                            </button>
                            <a asp-controller="Barbershops" asp-action="Details" asp-route-id="@barbershop?.Id" 
                               class="btn btn-outline-secondary">
                                <i class="fas fa-times"></i> Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="alert alert-warning mt-4">
                <i class="fas fa-info-circle"></i> 
                <strong>Nota:</strong> A sua reserva ficará pendente até ser confirmada pela barbearia. 
                Receberá uma notificação quando o estado da reserva for atualizado.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const toggle = document.getElementById('isOnSiteToggle');
        const details = document.getElementById('onSiteDetails');
        const userLat = document.getElementById('userLat');
        const userLng = document.getElementById('userLng');

        toggle.addEventListener('change', function () {
            if (this.checked) {
                details.classList.remove('d-none');
                getLocation();
            } else {
                details.classList.add('d-none');
                userLat.value = '';
                userLng.value = '';
            }
        });

        function getLocation() {
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(function (pos) {
                    userLat.value = pos.coords.latitude;
                    userLng.value = pos.coords.longitude;

                    const lat = pos.coords.latitude;
                    const lng = pos.coords.longitude;
                    fetch(`/Bookings/EstimateFee?barbershopId=@Model.BarbershopId&userLat=${lat}&userLng=${lng}`)
                        .then(r => r.json())
                        .then(data => {
                            document.getElementById('travelFeeEstimate').innerHTML =
                                `<strong>Distância estimada:</strong> ${data.distanceKm} km — <strong>Taxa: €${data.fee}</strong>`;
                        })
                        .catch(() => {
                            document.getElementById('travelFeeEstimate').textContent =
                                'Taxa calculada no momento da confirmação (base €5 + €0.75/km)';
                        });
                }, function () {
                    document.getElementById('travelFeeEstimate').textContent =
                        'Não foi possível obter localização. Partilha a localização para ver a estimativa.';
                });
            }
        }
    });
</script>
