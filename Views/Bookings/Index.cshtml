@model IEnumerable<WebApplication1.Models.Booking>

@{
    ViewData["Title"] = "Reservas Uber Barber";
}

<div class="container my-5">
    @* TempData feedback alerts *@
    <partial name="_NotificationAlerts" />

    <div class="row mb-4 align-items-center">
        <div class="col">
            <h1 class="section-title mb-0">
                <i class="fas fa-calendar-check me-2"></i>Reservas Uber Barber
            </h1>
        </div>
        <div class="col-auto">
            <a asp-controller="Barbershops" asp-action="Index"
               class="btn btn-primary btn-lg rounded-pill shadow-sm">
                <i class="fas fa-plus me-2"></i>Nova Reserva
            </a>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var booking in Model)
            {
                <div class="col-12">
                    <div class="card fade-in">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-md-8">
                                    <h5 class="card-title">
                                        <i class="fas fa-store text-accent"></i> 
                                        @if (booking.Barbershop != null)
                                        {
                                            @booking.Barbershop.Name
                                        }
                                        else
                                        {
                                            <span class="badge bg-info">Atendimento ao Domicílio</span>
                                        }
                                    </h5>
                                    <p class="mb-2">
                                        <i class="fas fa-calendar text-accent"></i> 
                                        <strong>Data:</strong> @booking.BookingDate.ToString("dd/MM/yyyy")
                                    </p>
                                    <p class="mb-2">
                                        <i class="fas fa-clock text-accent"></i> 
                                        <strong>Hora:</strong> @booking.BookingTime.ToString(@"hh\:mm")
                                    </p>
                                    @if (booking.Service != null)
                                    {
                                        <p class="mb-2">
                                            <i class="fas fa-scissors text-accent"></i> 
                                            <strong>Serviço:</strong> @booking.Service.Name 
                                            <span class="text-muted">(€@booking.Service.Price.ToString("0.00"))</span>
                                        </p>
                                    }
                                    @if (!string.IsNullOrEmpty(booking.Notes))
                                    {
                                        <p class="mb-2">
                                            <i class="fas fa-sticky-note text-accent"></i> 
                                            <strong>Notas:</strong> @booking.Notes
                                        </p>
                                    }
                                    <p class="mb-0">
                                        <strong>Estado:</strong>
                                        @switch (booking.Status)
                                        {
                                            case BookingStatus.Pending:
                                                <span class="badge bg-warning text-dark">
                                                    <i class="fas fa-hourglass-half"></i> Pendente
                                                </span>
                                                break;
                                            case BookingStatus.Confirmed:
                                                <span class="badge bg-success">
                                                    <i class="fas fa-check-circle"></i> Confirmada
                                                </span>
                                                break;
                                            case BookingStatus.Cancelled:
                                                <span class="badge bg-danger">
                                                    <i class="fas fa-times-circle"></i> Cancelada
                                                </span>
                                                break;
                                            case BookingStatus.Completed:
                                                <span class="badge bg-secondary">
                                                    <i class="fas fa-flag-checkered"></i> Concluída
                                                </span>
                                                break;
                                        }
                                    </p>
                                </div>
                                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                                    <a asp-controller="Barbershops" asp-action="Details" asp-route-id="@booking.BarbershopId" 
                                       class="btn btn-outline-primary mb-2 w-100">
                                        <i class="fas fa-info-circle"></i> Ver Barbearia
                                    </a>
                                    @if (booking.Status == BookingStatus.Pending || booking.Status == BookingStatus.Confirmed)
                                    {
                                        <form asp-action="Cancel" asp-route-id="@booking.Id" method="post" class="d-inline w-100"
                                              onsubmit="return confirm('Tem certeza que deseja cancelar esta reserva?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-danger w-100">
                                                <i class="fas fa-times"></i> Cancelar Reserva
                                            </button>
                                        </form>
                                    }
                                    @if (booking.Status == BookingStatus.Completed)
                                    {
                                        <a asp-controller="Reviews" asp-action="Create" asp-route-barbershopId="@booking.BarbershopId" 
                                           class="btn btn-warning w-100">
                                            <i class="fas fa-star"></i> Avaliar Serviço
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-12">
                <div class="alert alert-info text-center">
                    <i class="fas fa-info-circle fa-3x mb-3"></i>
                    <h5>Ainda não tem reservas</h5>
                    <p>Comece por explorar as barbearias disponíveis e faça a sua primeira reserva!</p>
                    <a asp-controller="Barbershops" asp-action="Index" class="btn btn-primary mt-3">
                        <i class="fas fa-search"></i> Procurar Barbearias
                    </a>
                </div>
            </div>
        </div>
    }
</div>
