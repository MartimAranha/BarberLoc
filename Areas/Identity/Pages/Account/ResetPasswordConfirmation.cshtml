@page
@model WebApplication1.Areas.Identity.Pages.Account.ResetPasswordConfirmationModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Senha redefinida";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="auth-page">
    <div class="hero-section auth-hero">
        <div class="container">
            <h1 class="mb-2">Senha redefinida</h1>
            <p class="lead">A sua senha foi atualizada com sucesso.</p>
        </div>
    </div>

<div class="container py-5" style="margin-top: -60px;">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 text-center">

                    @* Success checkmark icon *@
                    <div class="mb-3" style="font-size: 3rem; line-height: 1;">✅</div>

                    <h4 class="mb-2">Pronto!</h4>
                    <p class="text-muted small mb-4">
                        A sua senha foi redefinida com sucesso.
                        Pode agora iniciar sessão com a sua nova senha.
                    </p>

                    <a asp-area="Identity" asp-page="/Account/Login"
                       class="btn btn-primary btn-lg w-100">
                        Entrar na conta
                    </a>

                </div>
            </div>
        </div>
    </div>
</div>
</div>
