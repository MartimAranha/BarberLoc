@page
@model WebApplication1.Areas.Identity.Pages.Account.ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Instruções enviadas";
}
@* No-op patch to ensure file consistency *@

<div class="auth-page">
    <div class="hero-section">
        <div class="container">
            <h1 class="mb-2">Verifique o seu email</h1>
            <p class="lead">Enviámos instruções para redefinir a senha, verifique a sua caixa de entrada.</p>
        </div>
    </div>

    <div class="container py-5" style="margin-top: -60px;">
        <div class="row justify-content-center">
            <div class="col-md-7 col-lg-5">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4 text-center">
                        <h4 class="mb-3">Verifique o seu email</h4>
                        <p class="small text-muted">Se não receber o email em alguns minutos, verifique a pasta de spam.</p>
                        <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary mt-3">Voltar ao login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
