@page
@model WebApplication1.Areas.Identity.Pages.Account.ForgotPasswordModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Recuperar senha";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="auth-page">
    <div class="hero-section auth-hero">
        <div class="container">
            <h1 class="mb-2">Recuperar senha</h1>
            <p class="lead">Redefina o acesso à sua conta BarberLoc</p>
        </div>
    </div>

<div class="container py-5" style="margin-top: -60px;">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h4 class="card-title mb-3 text-center">Esqueceu a senha?</h4>
                    <p class="text-center text-muted small">Enviaremos instruções para redefinir a sua senha por email.</p>

                    <form method="post" asp-area="Identity" asp-page="/Account/ForgotPassword">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input asp-for="Input.Email" class="form-control form-control-lg" placeholder="seu@exemplo.com" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 mb-3">Enviar instruções</button>
                    </form>

                    <div class="mt-3 text-center small">
                        <a asp-area="Identity" asp-page="/Account/Login">Voltar ao login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
