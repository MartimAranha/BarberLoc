@page
@model WebApplication1.Areas.Identity.Pages.Account.LoginModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Entrar";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="auth-page">
    <div class="hero-section">
    <div class="container">
        <h1 class="mb-2">Bem-vindo de volta</h1>
        <p class="lead">Aceda à sua conta para gerir reservas e avaliações</p>
    </div>
    </div>

<div class="container py-5" style="margin-top: -60px;">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h4 class="card-title mb-3 text-center">Entrar</h4>
                    <p class="text-center text-muted small">Entre na sua conta BarberLoc</p>

                    <form method="post" asp-area="Identity" asp-page="/Account/Login">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input asp-for="Input.Email" class="form-control form-control-lg" placeholder="seu@exemplo.com" />
                            <span asp-validation-for="Input.Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Senha</label>
                            <input asp-for="Input.Password" class="form-control form-control-lg" />
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div class="form-check">
                                <input asp-for="Input.RememberMe" class="form-check-input" />
                                <label class="form-check-label small" for="Input_RememberMe">Lembrar-me</label>
                            </div>
                            <div>
                                <a asp-area="Identity" asp-page="/Account/ForgotPassword" class="small">Esqueceu a senha?</a>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 mb-3">Entrar</button>
                    </form>

                    <div class="text-center my-2 small text-muted">ou</div>

                    <form asp-area="Identity" asp-page="/Account/ExternalLogin" method="post" class="d-grid gap-2">
                        <input type="hidden" name="provider" value="Google" />
                        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                        <button type="submit" class="btn btn-google-login">
                            <i class="fab fa-google text-danger me-2"></i> Continuar com Google
                        </button>
                    </form>

                    <div class="mt-4 text-center small">
                        Não tem conta? <a asp-area="Identity" asp-page="/Account/Register">Registar-se</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
