@page
@model WebApplication1.Areas.Identity.Pages.Account.ResetPasswordModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Nova senha";
    Layout = "/Views/Shared/_Layout.cshtml";
}

<div class="auth-page">
    <div class="hero-section auth-hero">
        <div class="container">
            <h1 class="mb-2">Nova senha</h1>
            <p class="lead">Escolha uma nova senha para a sua conta BarberLoc</p>
        </div>
    </div>

<div class="container py-5" style="margin-top: -60px;">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h4 class="card-title mb-3 text-center">Redefinir senha</h4>
                    <p class="text-center text-muted small">Introduza e confirme a sua nova senha abaixo.</p>

                    <form method="post" asp-area="Identity" asp-page="/Account/ResetPassword">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        @* Hidden fields: token + email travel with the form on POST *@
                        <input asp-for="Input.Token" type="hidden" />
                        <input asp-for="Input.Email" type="hidden" />

                        <div class="mb-3">
                            <label class="form-label">Nova senha</label>
                            <input asp-for="Input.Password"
                                   class="form-control form-control-lg"
                                   placeholder="Mínimo 6 caracteres" />
                            <span asp-validation-for="Input.Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Confirmar nova senha</label>
                            <input asp-for="Input.ConfirmPassword"
                                   class="form-control form-control-lg"
                                   placeholder="Repita a nova senha" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 mb-3">
                            Guardar nova senha
                        </button>
                    </form>

                    <div class="mt-3 text-center small">
                        <a asp-area="Identity" asp-page="/Account/Login">Voltar ao login</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
