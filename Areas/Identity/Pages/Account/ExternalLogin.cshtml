@page
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model WebApplication1.Areas.Identity.Pages.Account.ExternalLoginModel
@{
    ViewData["Title"] = "Entrar com Google";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 p-4 text-center">
                <h5>Redirecionando para o provedor externo...</h5>
                <p class="small text-muted">Se não for redirecionado, clique no botão abaixo.</p>
                <form method="post">
                    <button type="submit" class="btn btn-primary">Continuar</button>
                </form>
            </div>
        </div>
    </div>
</div>
